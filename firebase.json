{
  "firestore": {
    "rules": "firebase/firestore.rules"
  },
  "hosting": {
    "public": "firebase/hosting",
    "ignore": ["**/.*"],
    "cleanUrls": true,
    "rewrites": [
      { "source": "/s/**", "destination": "/s/index.html" }
    ],
    "headers": [
      {
        "source": "/s/**",
        "headers": [
          { "key": "Cache-Control", "value": "no-cache" },
          { "key": "Referrer-Policy", "value": "no-referrer" },
          { "key": "X-Robots-Tag", "value": "noindex" }
        ]
      }
    ]
  }
}
