rules_version = '2';

// Reglas de Firebase Storage para Óptica App.
// Cópialas en Firebase Console > Storage > Reglas > Publicar.
service firebase.storage {
  match /b/{bucket}/o {

    // Foto de perfil: solo la sube su dueño; máximo 10 MB y solo imágenes
    match /users/{uid}/{archivo=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && request.auth.uid == uid
                   && request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // Logotipo y fotos de productos: solo el personal de esa óptica
    match /opticas/{opticaId}/{archivo=**} {
      allow read: if request.auth != null
                  && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.opticaId == opticaId;
      allow write: if request.auth != null
                   && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.opticaId == opticaId
                   && request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }
  }
}
