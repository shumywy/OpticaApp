<?xml version="1.0" encoding="utf-8"?>
<!--
    Fondo del menú lateral: degradado lila translúcido de arriba hacia abajo, borde blanco fino
    que simula el canto del vidrio y esquinas redondeadas del lado derecho.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <gradient
        android:angle="270"
        android:endColor="@color/menu_vidrio_fin"
        android:startColor="@color/menu_vidrio_inicio"
        android:type="linear" />
    <stroke
        android:width="1dp"
        android:color="@color/menu_vidrio_borde" />
    <corners
        android:bottomRightRadius="24dp"
        android:topRightRadius="24dp" />
</shape>
