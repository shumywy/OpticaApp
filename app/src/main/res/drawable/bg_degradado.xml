<?xml version="1.0" encoding="utf-8"?>
<!-- Fondo de toda la app: degradado lila → rosa (en modo oscuro, azul noche → morado) -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <gradient
        android:angle="315"
        android:centerColor="?attr/colorDegradadoCentro"
        android:endColor="?attr/colorDegradadoFin"
        android:startColor="?attr/colorDegradadoInicio"
        android:type="linear" />
</shape>
