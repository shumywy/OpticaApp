<?xml version="1.0" encoding="utf-8"?>
<!-- Tarjeta de vidrio: blanco translúcido más brillante arriba a la izquierda y borde blanco fino -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <gradient
        android:angle="315"
        android:endColor="@color/vidrio_fin"
        android:startColor="@color/vidrio_inicio"
        android:type="linear" />
    <stroke
        android:width="1dp"
        android:color="@color/vidrio_borde" />
    <corners android:radius="24dp" />
</shape>
