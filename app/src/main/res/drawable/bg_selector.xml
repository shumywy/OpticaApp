<?xml version="1.0" encoding="utf-8"?>
<!-- Fondo de las listas desplegables: igual que un campo, con flecha a la derecha -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/superficie" />
            <stroke android:width="1dp" android:color="@color/borde" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item
        android:width="22dp"
        android:height="22dp"
        android:drawable="@drawable/ic_flecha_abajo"
        android:end="14dp"
        android:gravity="end|center_vertical" />
</layer-list>
