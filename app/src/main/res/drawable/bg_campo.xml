<?xml version="1.0" encoding="utf-8"?>
<!-- Fondo de los campos: lila muy claro; blanco con borde azul cielo mientras se escribe -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="?attr/colorSuperficie" />
            <stroke android:width="1.5dp" android:color="?attr/colorAcento" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="?attr/colorTonalSuave" />
            <corners android:radius="14dp" />
        </shape>
    </item>
</selector>
