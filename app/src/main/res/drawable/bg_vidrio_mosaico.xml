<?xml version="1.0" encoding="utf-8"?>
<!-- Mosaico de vidrio del panel: blanco translúcido que termina en lila para que se note aun sobre blanco -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <gradient
        android:angle="315"
        android:endColor="@color/vidrio_mosaico_fin"
        android:startColor="@color/vidrio_mosaico_inicio"
        android:type="linear" />
    <stroke
        android:width="1dp"
        android:color="@color/vidrio_borde" />
    <corners android:radius="20dp" />
</shape>
