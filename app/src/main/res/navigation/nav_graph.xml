<?xml version="1.0" encoding="utf-8"?>
<!--
    Mapa de navegación. MainActivity cambia el destino inicial según haya sesión o no.
    Animaciones (res/anim): ir a un detalle o formulario = entra desde la derecha (nav_entrar…);
    cambiar de sección = se desvanece y crece un poco (nav_seccion_…). Las secciones de la barra
    inferior y del menú lateral usan las mismas desde MainActivity.navegarSeccion().
-->
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph"
    app:startDestination="@id/loginFragment">

    <fragment
        android:id="@+id/loginFragment"
        android:name="mx.itch.opticaapp.ui.login.LoginFragment"
        android:label="@string/titulo_login">
        <action
            android:id="@+id/action_login_to_registro"
            app:destination="@id/registroFragment"
            app:enterAnim="@anim/nav_entrar"
            app:exitAnim="@anim/nav_salir"
            app:popEnterAnim="@anim/nav_regresar_entrar"
            app:popExitAnim="@anim/nav_regresar_salir" />
    </fragment>

    <fragment
        android:id="@+id/registroFragment"
        android:name="mx.itch.opticaapp.ui.registro.RegistroFragment"
        android:label="@string/titulo_registro" />

    <fragment
        android:id="@+id/panelFragment"
        android:name="mx.itch.opticaapp.ui.panel.PanelFragment"
        android:label="@string/titulo_panel" />

    <fragment
        android:id="@+id/pacientesFragment"
        android:name="mx.itch.opticaapp.ui.pacientes.PacientesFragment"
        android:label="@string/titulo_pacientes">
        <action
            android:id="@+id/action_pacientes_to_expediente"
            app:destination="@id/expedienteFragment"
            app:enterAnim="@anim/nav_entrar"
            app:exitAnim="@anim/nav_salir"
            app:popEnterAnim="@anim/nav_regresar_entrar"
            app:popExitAnim="@anim/nav_regresar_salir" />
    </fragment>

    <fragment
        android:id="@+id/expedienteFragment"
        android:name="mx.itch.opticaapp.ui.expediente.ExpedienteFragment"
        android:label="@string/titulo_expediente" />

    <fragment
        android:id="@+id/inventarioFragment"
        android:name="mx.itch.opticaapp.ui.inventario.InventarioFragment"
        android:label="@string/titulo_inventario">
        <action
            android:id="@+id/action_inventario_to_productoForm"
            app:destination="@id/productoFormFragment"
            app:enterAnim="@anim/nav_entrar"
            app:exitAnim="@anim/nav_salir"
            app:popEnterAnim="@anim/nav_regresar_entrar"
            app:popExitAnim="@anim/nav_regresar_salir" />
        <action
            android:id="@+id/action_inventario_to_detalle"
            app:destination="@id/productoDetalleFragment"
            app:enterAnim="@anim/nav_entrar"
            app:exitAnim="@anim/nav_salir"
            app:popEnterAnim="@anim/nav_regresar_entrar"
            app:popExitAnim="@anim/nav_regresar_salir" />
    </fragment>

    <!-- Detalle de producto: "Editar" abre el formulario y "Vender" abre Punto de venta -->
    <fragment
        android:id="@+id/productoDetalleFragment"
        android:name="mx.itch.opticaapp.ui.inventario.ProductoDetalleFragment"
        android:label="@string/titulo_producto">
        <action
            android:id="@+id/action_detalle_to_productoForm"
            app:destination="@id/productoFormFragment"
            app:enterAnim="@anim/nav_entrar"
            app:exitAnim="@anim/nav_salir"
            app:popEnterAnim="@anim/nav_regresar_entrar"
            app:popExitAnim="@anim/nav_regresar_salir" />
        <!--
            Va a Ventas como si se tocara su botón de la barra inferior: deja guardado
            Inventario → Detalle para cuando el usuario regrese a esa sección.
        -->
        <action
            android:id="@+id/action_detalle_to_venta"
            app:destination="@id/ventaFragment"
            app:enterAnim="@anim/nav_seccion_entrar"
            app:exitAnim="@anim/nav_seccion_salir"
            app:popEnterAnim="@anim/nav_seccion_entrar"
            app:popExitAnim="@anim/nav_seccion_salir"
            app:popUpTo="@id/panelFragment"
            app:popUpToSaveState="true" />
    </fragment>

    <fragment
        android:id="@+id/productoFormFragment"
        android:name="mx.itch.opticaapp.ui.inventario.ProductoFormFragment"
        android:label="@string/titulo_producto" />

    <fragment
        android:id="@+id/ventaFragment"
        android:name="mx.itch.opticaapp.ui.venta.VentaFragment"
        android:label="@string/titulo_venta" />

    <fragment
        android:id="@+id/laboratorioFragment"
        android:name="mx.itch.opticaapp.ui.laboratorio.LaboratorioFragment"
        android:label="@string/titulo_laboratorio" />

    <fragment
        android:id="@+id/ajustesFragment"
        android:name="mx.itch.opticaapp.ui.ajustes.AjustesFragment"
        android:label="@string/titulo_ajustes" />

    <!-- ===== Menú lateral · Mi cuenta y Administración ===== -->
    <fragment
        android:id="@+id/perfilFragment"
        android:name="mx.itch.opticaapp.ui.administracion.PerfilFragment"
        android:label="@string/titulo_perfil" />

    <fragment
        android:id="@+id/opticaFragment"
        android:name="mx.itch.opticaapp.ui.administracion.OpticaFragment"
        android:label="@string/titulo_optica" />

    <fragment
        android:id="@+id/personalFragment"
        android:name="mx.itch.opticaapp.ui.administracion.PersonalFragment"
        android:label="@string/titulo_personal">
        <action
            android:id="@+id/action_personal_to_nuevaCuenta"
            app:destination="@id/nuevaCuentaFragment"
            app:enterAnim="@anim/nav_entrar"
            app:exitAnim="@anim/nav_salir"
            app:popEnterAnim="@anim/nav_regresar_entrar"
            app:popExitAnim="@anim/nav_regresar_salir" />
    </fragment>

    <fragment
        android:id="@+id/nuevaCuentaFragment"
        android:name="mx.itch.opticaapp.ui.administracion.NuevaCuentaFragment"
        android:label="@string/titulo_nueva_cuenta" />

</navigation>
