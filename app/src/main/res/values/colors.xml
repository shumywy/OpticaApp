<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        Colores que NO cambian con el tema: estados (verde entregado, naranja pendiente, rojo error...),
        blancos translúcidos del vidrio y el aviso flotante. values-night/colors.xml tiene su versión oscura.

        Los colores del tema (texto, acento, degradado, superficies...) son atributos ?attr/color...
        definidos en values/attrs.xml; cada tema (Cristal, Clínica, Carey) les da su valor en
        themes.xml con las paletas de values/colors_temas.xml y values-night/colors_temas.xml.
    -->

    <!-- Blanco translúcido de la búsqueda y las tarjetas de cristal -->
    <color name="blanco_translucido">#D9FFFFFF</color>

    <!-- Se conserva "azul" porque el código Java lo usa para la orden "En proceso" -->
    <color name="azul">#2A86D1</color>
    <color name="azul_claro">#E2F1FC</color>

    <!-- Indicadores de estado -->
    <color name="verde">#1F9A57</color>
    <color name="verde_claro">#E1F5EA</color>
    <color name="naranja">#D9730D</color>
    <color name="naranja_claro">#FDEFDF</color>
    <color name="rojo">#E5383B</color>
    <color name="rojo_claro">#FDE7E8</color>
    <!-- Estatus "Recibido" y rol Administrador en la lista de Personal (el violeta de marca es ?attr/colorMarca) -->
    <color name="morado">#5B21B6</color>
    <color name="morado_claro">#EDE9FE</color>
    <!-- Menú lateral de vidrio: bordes y brillos blancos; "Cerrar sesión" en rojo -->
    <color name="menu_vidrio_borde">#33FFFFFF</color>
    <color name="menu_salir">#BE123C</color>
    <color name="menu_seleccion">#B3FFFFFF</color>
    <color name="menu_divisor">#1A64748B</color>
    <color name="menu_foto_borde">#B3FFFFFF</color>

    <!-- Aviso flotante de confirmación (util/Aviso) -->
    <color name="aviso_fondo">#1F2937</color>

    <!-- Insignia neutra ("Sin graduación") -->
    <color name="gris_claro">#F1F5F9</color>

    <color name="blanco">#FFFFFF</color>
    <color name="ic_launcher_background">#E1D6F8</color>

    <!-- Panel de vidrio (Inicio): tarjetas translúcidas (el resplandor de color es ?attr/colorAurora...) -->
    <color name="vidrio_inicio">#A6FFFFFF</color>
    <color name="vidrio_fin">#52FFFFFF</color>
    <color name="vidrio_borde">#C7FFFFFF</color>
    <color name="vidrio_mosaico_inicio">#E6FFFFFF</color>
    <color name="vidrio_mosaico_fin">#99F2F0FF</color>
</resources>
