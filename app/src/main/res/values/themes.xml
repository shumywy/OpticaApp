<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!--
        Base común de los tres temas. Ningún color está fijo aquí: todos salen de los atributos
        ?attr/color... (values/attrs.xml), que cada tema llena con su paleta. Los valores están en
        values/colors_temas.xml (claro) y values-night/colors_temas.xml (oscuro), así que cada tema
        tiene automáticamente su versión oscura. El tema se elige en Ajustes › Apariencia (util/Temas).
    -->
    <style name="Base.Theme.OpticaApp" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Roles de Material 3: primario = acento del tema, terciario = tercer color del tema -->
        <item name="colorPrimary">?attr/colorAcento</item>
        <item name="colorOnPrimary">?attr/colorSobreAcento</item>
        <item name="colorPrimaryContainer">?attr/colorTonal</item>
        <item name="colorOnPrimaryContainer">?attr/colorTexto</item>
        <item name="colorSecondary">?attr/colorAcento</item>
        <item name="colorOnSecondary">?attr/colorSobreAcento</item>
        <item name="colorSecondaryContainer">?attr/colorTonal</item>
        <item name="colorOnSecondaryContainer">?attr/colorTexto</item>
        <item name="colorTertiary">?attr/colorTercero</item>
        <item name="colorTertiaryContainer">?attr/colorTerceroSuave</item>
        <item name="colorError">@color/rojo</item>

        <!-- Fondo en degradado con los colores del tema; hojas y tarjetas en la superficie -->
        <item name="android:windowBackground">@drawable/bg_degradado</item>
        <item name="android:colorBackground">?attr/colorFondo</item>
        <item name="colorSurface">?attr/colorSuperficie</item>
        <item name="colorOnSurface">?attr/colorTexto</item>
        <item name="colorOnSurfaceVariant">?attr/colorTextoSecundario</item>
        <item name="colorOutline">?attr/colorBorde</item>
        <item name="colorOutlineVariant">?attr/colorBorde</item>
        <item name="colorSurfaceContainerLowest">?attr/colorSuperficie</item>
        <item name="colorSurfaceContainerLow">?attr/colorSuperficie</item>
        <item name="colorSurfaceContainer">?attr/colorSuperficie</item>
        <item name="colorSurfaceContainerHigh">?attr/colorSuperficie</item>
        <item name="colorSurfaceContainerHighest">?attr/colorTonalSuave</item>
        <item name="colorControlNormal">?attr/colorTextoSecundario</item>

        <item name="android:textColorPrimary">?attr/colorTexto</item>
        <item name="android:textColorSecondary">?attr/colorTextoSecundario</item>
        <item name="android:textColorHint">?attr/colorTextoTenue</item>

        <!-- Fuente de todos los textos: Lexend (styles.xml solo cambia el grosor y el tamaño) -->
        <item name="android:fontFamily">@font/lexend_regular</item>
        <item name="fontFamily">@font/lexend_regular</item>

        <!-- Títulos, textos y botones de los cuadros de diálogo -->
        <item name="textAppearanceHeadlineSmall">@style/TextoDialogoTitulo</item>
        <item name="textAppearanceBodyMedium">@style/TextoDialogoCuerpo</item>
        <item name="textAppearanceLabelLarge">@style/TextoBoton</item>

        <!-- Estilos por defecto de los controles -->
        <item name="editTextStyle">@style/Campo</item>
        <item name="textInputStyle">@style/CampoMaterial</item>
        <item name="android:editTextStyle">@style/Campo</item>
        <item name="spinnerStyle">@style/Selector</item>
        <item name="android:spinnerStyle">@style/Selector</item>
        <item name="materialButtonStyle">@style/Boton</item>
        <item name="materialCardViewStyle">@style/Tarjeta</item>
        <item name="bottomNavigationStyle">@style/BarraInferior</item>
        <item name="toolbarStyle">@style/BarraSuperior</item>
        <item name="floatingActionButtonStyle">@style/BotonFlotante</item>
        <item name="bottomSheetDialogTheme">@style/ThemeOverlay.OpticaApp.HojaInferior</item>
        <item name="materialCalendarTheme">@style/ThemeOverlay.OpticaApp.Calendario</item>
    </style>

