<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Tema de la app. Cambiar un color o una fuente aquí lo cambia en todas las pantallas. -->
    <style name="Theme.OpticaApp" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Botones y switches en azul cielo -->
        <item name="colorPrimary">@color/cielo</item>
        <item name="colorOnPrimary">@color/blanco</item>
        <item name="colorPrimaryContainer">@color/lavanda</item>
        <item name="colorOnPrimaryContainer">@color/texto</item>
        <item name="colorSecondary">@color/cielo</item>
        <item name="colorOnSecondary">@color/blanco</item>
        <item name="colorSecondaryContainer">@color/lavanda</item>
        <item name="colorOnSecondaryContainer">@color/texto</item>
        <item name="colorTertiary">@color/morado</item>
        <item name="colorError">@color/rojo</item>

        <!-- Fondo en degradado lila → rosa; las hojas y tarjetas son blancas -->
        <item name="android:windowBackground">@drawable/bg_degradado</item>
        <item name="android:colorBackground">@color/fondo</item>
        <item name="colorSurface">@color/superficie</item>
        <item name="colorOnSurface">@color/texto</item>
        <item name="colorOnSurfaceVariant">@color/texto_secundario</item>
        <item name="colorOutline">@color/borde</item>
        <item name="colorOutlineVariant">@color/borde</item>
        <item name="colorSurfaceContainerLowest">@color/superficie</item>
        <item name="colorSurfaceContainerLow">@color/superficie</item>
        <item name="colorSurfaceContainer">@color/superficie</item>
        <item name="colorSurfaceContainerHigh">@color/superficie</item>
        <item name="colorSurfaceContainerHighest">@color/lavanda_suave</item>
        <item name="colorControlNormal">@color/texto_secundario</item>

        <item name="android:textColorPrimary">@color/texto</item>
        <item name="android:textColorSecondary">@color/texto_secundario</item>
        <item name="android:textColorHint">@color/texto_tenue</item>

        <!-- Fuente de todos los textos: Lexend (styles.xml solo cambia el grosor y el tamaño) -->
        <item name="android:fontFamily">@font/lexend_regular</item>
        <item name="fontFamily">@font/lexend_regular</item>

        <!-- Títulos, textos y botones de los cuadros de diálogo -->
        <item name="textAppearanceHeadlineSmall">@style/TextoDialogoTitulo</item>
        <item name="textAppearanceBodyMedium">@style/TextoDialogoCuerpo</item>
        <item name="textAppearanceLabelLarge">@style/TextoBoton</item>

        <!-- Estilos por defecto de los controles -->
        <item name="editTextStyle">@style/Campo</item>
        <item name="textInputStyle">@style/CampoMaterial</item>
        <item name="android:editTextStyle">@style/Campo</item>
        <item name="spinnerStyle">@style/Selector</item>
        <item name="android:spinnerStyle">@style/Selector</item>
        <item name="materialButtonStyle">@style/Boton</item>
        <item name="materialCardViewStyle">@style/Tarjeta</item>
        <item name="bottomNavigationStyle">@style/BarraInferior</item>
        <item name="toolbarStyle">@style/BarraSuperior</item>
        <item name="floatingActionButtonStyle">@style/BotonFlotante</item>
        <item name="bottomSheetDialogTheme">@style/ThemeOverlay.OpticaApp.HojaInferior</item>
        <item name="materialCalendarTheme">@style/ThemeOverlay.OpticaApp.Calendario</item>
    </style>

</resources>
