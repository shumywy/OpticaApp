<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:orientation="vertical">

    <!-- Se oculta en el inicio de sesión y en el panel (esas pantallas tienen su propio encabezado) -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- Fondo de pantalla personalizado (se elige en Perfil y ajustes) -->
        <ImageView
            android:id="@+id/ivFondo"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:alpha="0.25"
            android:contentDescription="@null"
            android:scaleType="centerCrop"
            android:visibility="gone" />

        <!-- Aquí se muestran todas las pantallas (Fragments) -->
        <androidx.fragment.app.FragmentContainerView
            android:id="@+id/navHost"
            android:name="androidx.navigation.fragment.NavHostFragment"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:defaultNavHost="true" />
    </FrameLayout>

    <!-- Línea fina arriba de la barra inferior -->
    <View
        android:id="@+id/divisorNav"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/borde" />

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:menu="@menu/bottom_nav" />

</LinearLayout>
