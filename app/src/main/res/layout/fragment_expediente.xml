<?xml version="1.0" encoding="utf-8"?>
<!-- Pantalla 5: Expediente clínico y captura de graduación -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- ===== Encabezado del paciente sobre el degradado ===== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="24dp"
            android:paddingTop="4dp"
            android:paddingEnd="24dp"
            android:paddingBottom="28dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/Texto.Eyebrow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Expediente clínico" />

                <TextView
                    android:id="@+id/tvPaciente"
                    style="@style/Texto.Hero"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:textSize="26sp"
                    tools:text="María Fernanda López" />

                <TextView
                    android:id="@+id/tvDatosPaciente"
                    style="@style/Texto.Secundario"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    tools:text="34 años · Paciente desde 12/03/2024" />
            </LinearLayout>

            <!-- Iniciales en un círculo blanco -->
            <TextView
                android:id="@+id/tvIniciales"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:layout_marginStart="12dp"
                android:background="@drawable/bg_icono_circulo"
                android:fontFamily="@font/lexend_exa_medium"
                android:gravity="center"
                android:textColor="@color/texto"
                android:textSize="17sp"
                tools:text="MF" />
        </LinearLayout>

        <!-- ===== Hoja blanca: graduación e historial ===== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@drawable/bg_hoja"
            android:divider="@drawable/espacio"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="26dp"
            android:paddingEnd="20dp"
            android:paddingBottom="24dp"
            android:showDividers="middle">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/Texto.Seccion"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Graduación" />

                <TextView
                    style="@style/Texto.Categoria"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Nueva consulta" />
            </LinearLayout>

            <TableLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:stretchColumns="1,2,3,4">

                <TableRow android:layout_marginBottom="6dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="" />

                    <TextView
                        style="@style/Texto.Categoria"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="ESF" />

                    <TextView
                        style="@style/Texto.Categoria"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="CIL" />

                    <TextView
                        style="@style/Texto.Categoria"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="EJE" />

                    <TextView
                        style="@style/Texto.Categoria"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="ADD" />
                </TableRow>

                <TableRow android:gravity="center_vertical">

                    <TextView
                        style="@style/Texto.Valor"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingEnd="10dp"
                        android:text="OD" />

                    <EditText
                        android:id="@+id/etOdEsfera"
                        style="@style/Campo.Compacto"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="4dp"
                        android:layout_weight="1"
                        android:hint="0.00"
                        android:importantForAutofill="no"
                        android:inputType="numberSigned|numberDecimal" />

                    <EditText
                        android:id="@+id/etOdCilindro"
                        style="@style/Campo.Compacto"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="4dp"
                        android:layout_weight="1"
                        android:hint="0.00"
                        android:importantForAutofill="no"
                        android:inputType="numberSigned|numberDecimal" />

                    <EditText
                        android:id="@+id/etOdEje"
                        style="@style/Campo.Compacto"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="4dp"
                        android:layout_weight="1"
                        android:hint="°"
                        android:importantForAutofill="no"
                        android:inputType="number" />

                    <EditText
                        android:id="@+id/etOdAdicion"
                        style="@style/Campo.Compacto"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:hint="0.00"
                        android:importantForAutofill="no"
                        android:inputType="numberDecimal" />
                </TableRow>

                <TableRow
                    android:layout_marginTop="8dp"
                    android:gravity="center_vertical">

                    <TextView
                        style="@style/Texto.Valor"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingEnd="10dp"
                        android:text="OI" />

                    <EditText
                        android:id="@+id/etOiEsfera"
                        style="@style/Campo.Compacto"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="4dp"
                        android:layout_weight="1"
                        android:hint="0.00"
                        android:importantForAutofill="no"
                        android:inputType="numberSigned|numberDecimal" />

                    <EditText
                        android:id="@+id/etOiCilindro"
                        style="@style/Campo.Compacto"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="4dp"
                        android:layout_weight="1"
                        android:hint="0.00"
                        android:importantForAutofill="no"
                        android:inputType="numberSigned|numberDecimal" />

                    <EditText
                        android:id="@+id/etOiEje"
                        style="@style/Campo.Compacto"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="4dp"
                        android:layout_weight="1"
                        android:hint="°"
                        android:importantForAutofill="no"
                        android:inputType="number" />

                    <EditText
                        android:id="@+id/etOiAdicion"
                        style="@style/Campo.Compacto"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:hint="0.00"
                        android:importantForAutofill="no"
                        android:inputType="numberDecimal" />
                </TableRow>
            </TableLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/etDistanciaPupilar"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:hint="DIP (mm)"
                    android:importantForAutofill="no"
                    android:inputType="numberDecimal" />

                <EditText
                    android:id="@+id/etAgudezaVisual"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="Agudeza (20/20)"
                    android:importantForAutofill="no"
                    android:inputType="text" />
            </LinearLayout>

            <TextView
                style="@style/Texto.Categoria"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginTop="4dp"
                android:text="Tipo de lente" />

            <Spinner
                android:id="@+id/spTipoLente"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <EditText
                android:id="@+id/etObservaciones"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="top"
                android:hint="Observaciones"
                android:importantForAutofill="no"
                android:inputType="textMultiLine|textCapSentences"
                android:minLines="3" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnPdf"
                    style="@style/Boton.Secundario"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="10dp"
                    android:layout_weight="1"
                    android:minHeight="56dp"
                    android:text="Receta PDF"
                    app:icon="@drawable/ic_documento" />

                <Button
                    android:id="@+id/btnGuardar"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1.3"
                    android:text="Guardar" />
            </LinearLayout>

            <TextView
                style="@style/Texto.Seccion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginTop="16dp"
                android:text="Historial de consultas" />

            <TextView
                android:id="@+id/tvSinHistorial"
                style="@style/Texto.Secundario"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="Sin consultas registradas. Toca una consulta para cargarla en el formulario." />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvHistorial"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                tools:itemCount="2"
                tools:listitem="@layout/item_consulta" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
