<?xml version="1.0" encoding="utf-8"?>
<!-- Pantalla 5: Expediente clínico y captura de graduación -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:divider="@drawable/espacio"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="4dp"
        android:paddingEnd="16dp"
        android:paddingBottom="24dp"
        android:showDividers="middle">

        <!-- Encabezado del paciente -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                style="@style/Fila"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@null">

                <TextView
                    android:id="@+id/tvIniciales"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:layout_marginEnd="14dp"
                    android:background="@drawable/bg_avatar"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:textColor="@color/azul"
                    android:textSize="17sp"
                    tools:text="MF" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvPaciente"
                        style="@style/Texto.Seccion"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="18sp"
                        tools:text="María Fernanda López" />

                    <TextView
                        android:id="@+id/tvDatosPaciente"
                        style="@style/Texto.Secundario"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        tools:text="34 años · Paciente desde 12/03/2024" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Graduación -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    style="@style/Texto.Seccion"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:text="Graduación" />

                <TableLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:stretchColumns="1,2,3,4">

                    <TableRow>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="" />

                        <TextView
                            style="@style/Texto.Etiqueta"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:text="ESF" />

                        <TextView
                            style="@style/Texto.Etiqueta"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:text="CIL" />

                        <TextView
                            style="@style/Texto.Etiqueta"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:text="EJE" />

                        <TextView
                            style="@style/Texto.Etiqueta"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:text="ADD" />
                    </TableRow>

                    <TableRow android:gravity="center_vertical">

                        <TextView
                            style="@style/Texto.Fila"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:paddingEnd="8dp"
                            android:text="OD" />

                        <EditText
                            android:id="@+id/etOdEsfera"
                            style="@style/Campo.Compacto"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="4dp"
                            android:layout_weight="1"
                            android:hint="0.00"
                            android:importantForAutofill="no"
                            android:inputType="numberSigned|numberDecimal" />

                        <EditText
                            android:id="@+id/etOdCilindro"
                            style="@style/Campo.Compacto"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="4dp"
                            android:layout_weight="1"
                            android:hint="0.00"
                            android:importantForAutofill="no"
                            android:inputType="numberSigned|numberDecimal" />

                        <EditText
                            android:id="@+id/etOdEje"
                            style="@style/Campo.Compacto"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="4dp"
                            android:layout_weight="1"
                            android:hint="°"
                            android:importantForAutofill="no"
                            android:inputType="number" />

                        <EditText
                            android:id="@+id/etOdAdicion"
                            style="@style/Campo.Compacto"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:hint="0.00"
                            android:importantForAutofill="no"
                            android:inputType="numberDecimal" />
                    </TableRow>

                    <TableRow
                        android:layout_marginTop="8dp"
                        android:gravity="center_vertical">

                        <TextView
                            style="@style/Texto.Fila"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:paddingEnd="8dp"
                            android:text="OI" />

                        <EditText
                            android:id="@+id/etOiEsfera"
                            style="@style/Campo.Compacto"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="4dp"
                            android:layout_weight="1"
                            android:hint="0.00"
                            android:importantForAutofill="no"
                            android:inputType="numberSigned|numberDecimal" />

                        <EditText
                            android:id="@+id/etOiCilindro"
                            style="@style/Campo.Compacto"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="4dp"
                            android:layout_weight="1"
                            android:hint="0.00"
                            android:importantForAutofill="no"
                            android:inputType="numberSigned|numberDecimal" />

                        <EditText
                            android:id="@+id/etOiEje"
                            style="@style/Campo.Compacto"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="4dp"
                            android:layout_weight="1"
                            android:hint="°"
                            android:importantForAutofill="no"
                            android:inputType="number" />

                        <EditText
                            android:id="@+id/etOiAdicion"
                            style="@style/Campo.Compacto"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:hint="0.00"
                            android:importantForAutofill="no"
                            android:inputType="numberDecimal" />
                    </TableRow>
                </TableLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">

                    <EditText
                        android:id="@+id/etDistanciaPupilar"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"
                        android:layout_weight="1"
                        android:hint="DIP (mm)"
                        android:importantForAutofill="no"
                        android:inputType="numberDecimal" />

                    <EditText
                        android:id="@+id/etAgudezaVisual"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:hint="Agudeza (20/20)"
                        android:importantForAutofill="no"
                        android:inputType="text" />
                </LinearLayout>

                <TextView
                    style="@style/Texto.Secundario"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Tipo de lente" />

                <Spinner
                    android:id="@+id/spTipoLente"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp" />

                <EditText
                    android:id="@+id/etObservaciones"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="top"
                    android:hint="Observaciones"
                    android:importantForAutofill="no"
                    android:inputType="textMultiLine|textCapSentences"
                    android:minLines="3" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnPdf"
                style="@style/Boton.Secundario"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:minHeight="54dp"
                android:text="Receta PDF"
                app:icon="@drawable/ic_documento" />

            <Button
                android:id="@+id/btnGuardar"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1.3"
                android:text="Guardar" />
        </LinearLayout>

        <TextView
            style="@style/Texto.Seccion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Historial de consultas" />

        <TextView
            android:id="@+id/tvSinHistorial"
            style="@style/Texto.Secundario"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Sin consultas registradas. Toca una consulta para cargarla en el formulario." />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvHistorial"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false"
            tools:itemCount="2"
            tools:listitem="@layout/item_consulta" />
    </LinearLayout>
</ScrollView>
