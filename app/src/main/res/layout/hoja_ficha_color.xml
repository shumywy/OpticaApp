<?xml version="1.0" encoding="utf-8"?>
<!--
    Ficha de un color (hoja inferior al tocar un rol o un tono en Esquema de color):
    muestra grande con su tono, código HEX y RGB, contraste con su pareja y para qué se usa.
-->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingBottom="20dp">

        <com.google.android.material.bottomsheet.BottomSheetDragHandleView
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <FrameLayout
            android:id="@+id/muestraFicha"
            android:layout_width="match_parent"
            android:layout_height="110dp"
            android:background="@drawable/bg_redondeado">

            <TextView
                android:id="@+id/tvEjemploFicha"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="start|bottom"
                android:layout_margin="14dp"
                android:fontFamily="?attr/fuenteFuerte"
                android:text="Aa"
                android:textSize="30sp" />

            <TextView
                android:id="@+id/tvTonoFicha"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end|top"
                android:layout_margin="14dp"
                android:fontFamily="?attr/fuenteMedia"
                android:textSize="13sp"
                tools:text="T40" />
        </FrameLayout>

        <TextView
            android:id="@+id/tvTituloFicha"
            style="@style/Texto.TituloHoja"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            tools:text="Primary" />

        <TextView
            android:id="@+id/tvSubtituloFicha"
            style="@style/Texto.Secundario"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            tools:text="Paleta Primary · tono T69" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_contenedor_fino"
            android:orientation="vertical"
            android:paddingStart="14dp"
            android:paddingTop="6dp"
            android:paddingEnd="14dp"
            android:paddingBottom="6dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingTop="6dp"
                android:paddingBottom="6dp">

                <TextView
                    style="@style/Texto.Categoria"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="HEX" />

                <TextView
                    android:id="@+id/tvHexFicha"
                    style="@style/Texto"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    tools:text="#3BB4F2" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingTop="6dp"
                android:paddingBottom="6dp">

                <TextView
                    style="@style/Texto.Categoria"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="RGB" />

                <TextView
                    android:id="@+id/tvRgbFicha"
                    style="@style/Texto"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    tools:text="59, 180, 242" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/filaContrasteFicha"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingTop="6dp"
                android:paddingBottom="6dp">

                <TextView
                    android:id="@+id/tvEtiquetaContrasteFicha"
                    style="@style/Texto.Categoria"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    tools:text="Contraste con On Primary" />

                <TextView
                    android:id="@+id/tvContrasteFicha"
                    style="@style/Texto"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="?attr/fuenteMedia"
                    tools:text="2.3:1 · decorativo" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            style="@style/Texto.Categoria"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Se usa en" />

        <TextView
            android:id="@+id/tvUsoFicha"
            style="@style/Texto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:lineSpacingMultiplier="1.15"
            tools:text="Componentes principales: botones rellenos, FAB, estados activos." />

        <Button
            android:id="@+id/btnCopiarFicha"
            style="@style/Boton.Secundario"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Copiar código" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
