<?xml version="1.0" encoding="utf-8"?>
<!-- Pantalla 6: Inventario -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingTop="4dp">

        <EditText
            android:id="@+id/etBuscar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:drawableStart="@drawable/ic_buscar"
            android:drawablePadding="12dp"
            android:drawableTint="@color/texto_secundario"
            android:hint="Buscar producto"
            android:importantForAutofill="no"
            android:inputType="text" />

        <!-- Filtro por categoría -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:clipToPadding="false"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:scrollbars="none">

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipsCategoria"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:selectionRequired="true"
                app:singleLine="true"
                app:singleSelection="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipTodas"
                    style="@style/Filtro"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="Todas" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipArmazones"
                    style="@style/Filtro"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Armazones" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipMicas"
                    style="@style/Filtro"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Micas" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipContacto"
                    style="@style/Filtro"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Lentes de contacto" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipAccesorios"
                    style="@style/Filtro"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Accesorios" />
            </com.google.android.material.chip.ChipGroup>
        </HorizontalScrollView>

        <TextView
            android:id="@+id/tvVacio"
            style="@style/Texto.Secundario"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="32dp"
            android:text="No hay productos en esta categoría"
            android:visibility="gone" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvProductos"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="88dp"
            tools:itemCount="4"
            tools:listitem="@layout/item_producto" />
    </LinearLayout>

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabAgregar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="16dp"
        android:contentDescription="Agregar producto"
        android:src="@drawable/ic_agregar" />
</FrameLayout>
