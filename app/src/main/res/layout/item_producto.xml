<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="10dp"
    app:cardCornerRadius="18dp">

    <LinearLayout
        style="@style/Fila"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="10dp">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/ivFoto"
            android:layout_width="68dp"
            android:layout_height="68dp"
            android:layout_marginEnd="14dp"
            android:background="@color/icono_fondo"
            android:contentDescription="Foto del producto"
            android:scaleType="centerCrop"
            app:shapeAppearanceOverlay="@style/Forma.Redondeada" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvNombre"
                style="@style/Texto.Fila"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                tools:text="Acetato A-102" />

            <TextView
                android:id="@+id/tvCategoria"
                style="@style/Texto.Secundario"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                tools:text="Armazones" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvPrecio"
                    style="@style/Texto.Valor"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="10dp"
                    android:textSize="15sp"
                    tools:text="$1,450.00" />

                <TextView
                    android:id="@+id/tvStock"
                    style="@style/Texto.Pildora"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_pildora_verde"
                    android:textColor="@color/verde"
                    tools:text="8 en stock" />
            </LinearLayout>
        </LinearLayout>

        <ImageView
            style="@style/FlechaFila"
            android:layout_width="22dp"
            android:layout_height="22dp" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
