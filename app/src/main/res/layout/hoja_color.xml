<?xml version="1.0" encoding="utf-8"?>
<!--
    Hoja inferior "Agregar color exacto" (detalle de producto): muestra en vivo, nombre y código
    hexadecimal. Va dentro de un NestedScrollView para que con el teclado abierto se pueda
    llegar al botón Agregar.
-->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="16dp">

        <com.google.android.material.bottomsheet.BottomSheetDragHandleView
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            style="@style/Texto.TituloHoja"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:text="Agregar color exacto" />

        <TextView
            style="@style/Texto.Secundario"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:text="Se agrega a las variantes de este producto" />

        <!-- Muestra en vivo: cambia mientras se escribe el código -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="24dp"
            android:background="@drawable/bg_contenedor_fino"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="12dp">

            <mx.itch.opticaapp.ui.inventario.MuestraColor
                android:id="@+id/muestraPrevia"
                android:layout_width="52dp"
                android:layout_height="52dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvMuestraNombre"
                    style="@style/Texto.Fila"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Nuevo color" />

                <TextView
                    android:id="@+id/tvMuestraHex"
                    style="@style/Texto.Secundario"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Escribe el código, por ejemplo #3C434A" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:divider="@drawable/espacio"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:showDividers="middle">

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilNombreColor"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Nombre del color"
                app:counterEnabled="true"
                app:counterMaxLength="20"
                app:placeholderText="Ej. Gris Oxford">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etNombreColor"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:importantForAutofill="no"
                    android:inputType="textCapWords"
                    android:maxLength="20" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilHexColor"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Código de color"
                app:helperText="Seis dígitos hexadecimales, con o sin #"
                app:placeholderText="#3C434A">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etHexColor"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:digits="#0123456789ABCDEFabcdef"
                    android:imeOptions="actionDone"
                    android:importantForAutofill="no"
                    android:inputType="textCapCharacters"
                    android:maxLength="7" />
            </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="end|center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="24dp">

            <Button
                android:id="@+id/btnCancelarColor"
                style="@style/Boton.Texto"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:text="Cancelar" />

            <Button
                android:id="@+id/btnAgregarColor"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="28dp"
                android:paddingEnd="28dp"
                android:text="Agregar" />
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
