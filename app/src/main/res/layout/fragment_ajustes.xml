<?xml version="1.0" encoding="utf-8"?>
<!-- Pantalla 9: Perfil y ajustes -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="24dp">

        <!-- ===== Perfil: foto, nombre, correo y botón ===== -->
        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/ivFoto"
            android:layout_width="104dp"
            android:layout_height="104dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="8dp"
            android:background="@color/superficie"
            android:contentDescription="Foto de perfil"
            android:scaleType="centerCrop"
            app:shapeAppearanceOverlay="@style/Forma.Circulo" />

        <TextView
            android:id="@+id/tvNombre"
            style="@style/Texto.Titulo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="14dp"
            tools:text="Laura Martínez" />

        <TextView
            android:id="@+id/tvCorreo"
            style="@style/Texto.Secundario"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="2dp"
            tools:text="laura@correo.com" />

        <Button
            android:id="@+id/btnFoto"
            style="@style/Boton.Secundario"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="12dp"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:text="Cambiar foto" />

        <ProgressBar
            android:id="@+id/progreso"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:visibility="gone" />

        <!-- ===== Mi cuenta ===== -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp">

            <LinearLayout
                style="@style/Fila"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@null">

                <ImageView
                    style="@style/IconoFila"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_tienda" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Texto.Fila"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Mi óptica" />

                    <TextView
                        android:id="@+id/tvRol"
                        style="@style/Texto.Secundario"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        tools:text="Óptica Vista Clara · Administrador" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ===== Apariencia ===== -->
        <TextView
            style="@style/Texto.Seccion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="10dp"
            android:text="Apariencia" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Tema -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            style="@style/IconoFila"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_paleta" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                style="@style/Texto.Fila"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Tema" />

                            <TextView
                                style="@style/Texto.Secundario"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Claro, oscuro o el del teléfono" />
                        </LinearLayout>
                    </LinearLayout>

                    <RadioGroup
                        android:id="@+id/rgTema"
                        style="@style/Segmentos"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp">

                        <RadioButton
                            android:id="@+id/rbTemaSistema"
                            style="@style/Segmento"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Sistema" />

                        <RadioButton
                            android:id="@+id/rbTemaClaro"
                            style="@style/Segmento"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Claro" />

                        <RadioButton
                            android:id="@+id/rbTemaOscuro"
                            style="@style/Segmento"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Oscuro" />
                    </RadioGroup>
                </LinearLayout>

                <View
                    style="@style/Divisor"
                    android:layout_width="match_parent"
                    android:layout_height="1dp" />

                <!-- Modo sin imágenes -->
                <LinearLayout
                    style="@style/Fila"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@null">

                    <ImageView
                        style="@style/IconoFila"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_sin_imagenes" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/Texto.Fila"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Modo sin imágenes" />

                        <TextView
                            style="@style/Texto.Secundario"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Ahorra datos móviles" />
                    </LinearLayout>

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/swSinImagenes"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:contentDescription="Modo sin imágenes" />
                </LinearLayout>

                <View
                    style="@style/Divisor"
                    android:layout_width="match_parent"
                    android:layout_height="1dp" />

                <!-- Texto grande -->
                <LinearLayout
                    style="@style/Fila"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@null">

                    <ImageView
                        style="@style/IconoFila"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_texto" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/Texto.Fila"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Texto grande" />

                        <TextView
                            style="@style/Texto.Secundario"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Mejora la legibilidad" />
                    </LinearLayout>

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/swTextoGrande"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:contentDescription="Texto grande" />
                </LinearLayout>

                <View
                    style="@style/Divisor"
                    android:layout_width="match_parent"
                    android:layout_height="1dp" />

                <!-- Fondo de pantalla -->
                <LinearLayout
                    android:id="@+id/filaFondo"
                    style="@style/Fila"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <ImageView
                        style="@style/IconoFila"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_imagen" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/Texto.Fila"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Fondo de pantalla" />

                        <TextView
                            android:id="@+id/tvFondo"
                            style="@style/Texto.Secundario"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            tools:text="Imagen personalizada" />
                    </LinearLayout>

                    <Button
                        android:id="@+id/btnQuitarFondo"
                        style="@style/Boton.Texto"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Quitar" />

                    <ImageView
                        style="@style/FlechaFila"
                        android:layout_width="22dp"
                        android:layout_height="22dp" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ===== Opciones del administrador ===== -->
        <LinearLayout
            android:id="@+id/layoutAdmin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            tools:visibility="visible">

            <TextView
                style="@style/Texto.Seccion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="10dp"
                android:text="Mi óptica" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:id="@+id/filaCodigo"
                        style="@style/Fila"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <ImageView
                            style="@style/IconoFila"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_llave" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                style="@style/Texto.Fila"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Código de invitación" />

                            <TextView
                                android:id="@+id/tvCodigo"
                                style="@style/Texto.Secundario"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="monospace"
                                android:textColor="@color/azul"
                                tools:text="OPT-7K2Q9X" />
                        </LinearLayout>

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:contentDescription="Copiar"
                            android:src="@drawable/ic_copiar"
                            app:tint="@color/texto_secundario" />
                    </LinearLayout>

                    <View
                        style="@style/Divisor"
                        android:layout_width="match_parent"
                        android:layout_height="1dp" />

                    <LinearLayout
                        android:id="@+id/filaPersonal"
                        style="@style/Fila"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <ImageView
                            style="@style/IconoFila"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_pacientes" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                style="@style/Texto.Fila"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Personal y roles" />

                            <TextView
                                style="@style/Texto.Secundario"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Cambia el puesto de tu equipo" />
                        </LinearLayout>

                        <ImageView
                            style="@style/FlechaFila"
                            android:layout_width="22dp"
                            android:layout_height="22dp" />
                    </LinearLayout>

                    <View
                        style="@style/Divisor"
                        android:layout_width="match_parent"
                        android:layout_height="1dp" />

                    <LinearLayout
                        android:id="@+id/filaCorte"
                        style="@style/Fila"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <ImageView
                            style="@style/IconoFila"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_recibo" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                style="@style/Texto.Fila"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Corte de caja del día" />

                            <TextView
                                style="@style/Texto.Secundario"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Ventas y dinero cobrado hoy" />
                        </LinearLayout>

                        <ImageView
                            style="@style/FlechaFila"
                            android:layout_width="22dp"
                            android:layout_height="22dp" />
                    </LinearLayout>

                    <View
                        style="@style/Divisor"
                        android:layout_width="match_parent"
                        android:layout_height="1dp" />

                    <LinearLayout
                        android:id="@+id/filaMeta"
                        style="@style/Fila"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <ImageView
                            style="@style/IconoFila"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_meta" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                style="@style/Texto.Fila"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Meta de ventas semanal" />

                            <TextView
                                android:id="@+id/tvMetaActual"
                                style="@style/Texto.Secundario"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                tools:text="$30,000.00" />
                        </LinearLayout>

                        <ImageView
                            style="@style/FlechaFila"
                            android:layout_width="22dp"
                            android:layout_height="22dp" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <!-- ===== Cerrar sesión ===== -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp">

            <LinearLayout
                android:id="@+id/filaCerrarSesion"
                style="@style/Fila"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <ImageView
                    style="@style/IconoFila"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_salir"
                    app:tint="@color/rojo" />

                <TextView
                    style="@style/Texto.Fila"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Cerrar sesión"
                    android:textColor="@color/rojo" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</ScrollView>
