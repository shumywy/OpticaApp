<?xml version="1.0" encoding="utf-8"?>
<!--
    Configuración: apariencia de la app en este teléfono y cerrar sesión.
    (El perfil, los datos de la óptica y el personal ahora están en el menú lateral → Administración.)
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- ===== Encabezado sobre el degradado ===== -->
        <LinearLayout
            android:id="@+id/encabezado"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingTop="4dp"
            android:paddingEnd="24dp"
            android:paddingBottom="28dp">

            <TextView
                style="@style/Texto.Eyebrow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ajustes" />

            <TextView
                style="@style/Texto.Hero"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Configuración" />

            <TextView
                style="@style/Texto.Secundario"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Cómo se ve la app en este teléfono." />
        </LinearLayout>

        <!-- ===== Hoja blanca con las opciones ===== -->
        <LinearLayout
            android:id="@+id/hoja"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@drawable/bg_hoja"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="26dp"
            android:paddingEnd="20dp"
            android:paddingBottom="24dp">

            <!-- ===== Apariencia ===== -->
            <TextView
                style="@style/Texto.Seccion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginBottom="10dp"
                android:text="Apariencia" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- Tema -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                style="@style/IconoFila"
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:importantForAccessibility="no"
                                android:src="@drawable/ic_paleta" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    style="@style/Texto.Fila"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Tema" />

                                <TextView
                                    style="@style/Texto.Secundario"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Claro, oscuro o el del teléfono" />
                            </LinearLayout>
                        </LinearLayout>

                        <RadioGroup
                            android:id="@+id/rgTema"
                            style="@style/Segmentos"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp">

                            <RadioButton
                                android:id="@+id/rbTemaSistema"
                                style="@style/Segmento"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Sistema" />

                            <RadioButton
                                android:id="@+id/rbTemaClaro"
                                style="@style/Segmento"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Claro" />

                            <RadioButton
                                android:id="@+id/rbTemaOscuro"
                                style="@style/Segmento"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Oscuro" />
                        </RadioGroup>
                    </LinearLayout>

                    <View
                        style="@style/Divisor"
                        android:layout_width="match_parent"
                        android:layout_height="1dp" />

                    <!-- Modo sin imágenes -->
                    <LinearLayout
                        style="@style/Fila"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@null">

                        <ImageView
                            style="@style/IconoFila"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_sin_imagenes" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                style="@style/Texto.Fila"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Modo sin imágenes" />

                            <TextView
                                style="@style/Texto.Secundario"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Ahorra datos móviles" />
                        </LinearLayout>

                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/swSinImagenes"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:contentDescription="Modo sin imágenes" />
                    </LinearLayout>

                    <View
                        style="@style/Divisor"
                        android:layout_width="match_parent"
                        android:layout_height="1dp" />

                    <!-- Texto grande -->
                    <LinearLayout
                        style="@style/Fila"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@null">

                        <ImageView
                            style="@style/IconoFila"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_texto" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                style="@style/Texto.Fila"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Texto grande" />

                            <TextView
                                style="@style/Texto.Secundario"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Mejora la legibilidad" />
                        </LinearLayout>

                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/swTextoGrande"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:contentDescription="Texto grande" />
                    </LinearLayout>

                    <View
                        style="@style/Divisor"
                        android:layout_width="match_parent"
                        android:layout_height="1dp" />

                    <!-- Fondo de pantalla -->
                    <LinearLayout
                        android:id="@+id/filaFondo"
                        style="@style/Fila"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <ImageView
                            style="@style/IconoFila"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_imagen" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                style="@style/Texto.Fila"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Fondo de pantalla" />

                            <TextView
                                android:id="@+id/tvFondo"
                                style="@style/Texto.Secundario"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                tools:text="Imagen personalizada" />
                        </LinearLayout>

                        <Button
                            android:id="@+id/btnQuitarFondo"
                            style="@style/Boton.Texto"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Quitar" />

                        <ImageView
                            style="@style/FlechaFila"
                            android:layout_width="22dp"
                            android:layout_height="22dp" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ===== Cerrar sesión ===== -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp">

                <LinearLayout
                    android:id="@+id/filaCerrarSesion"
                    style="@style/Fila"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <ImageView
                        style="@style/IconoFila"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_salir"
                        app:tint="@color/rojo" />

                    <TextView
                        style="@style/Texto.Fila"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Cerrar sesión"
                        android:textColor="@color/rojo" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
