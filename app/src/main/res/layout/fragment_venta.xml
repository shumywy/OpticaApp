<?xml version="1.0" encoding="utf-8"?>
<!--
    Pantalla 7: Punto de venta. El formulario se desplaza; abajo queda fijo
    el total con el botón principal para confirmar la venta.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- ===== Encabezado sobre el degradado ===== -->
            <LinearLayout
                android:id="@+id/encabezado"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="24dp"
                android:paddingTop="4dp"
                android:paddingEnd="24dp"
                android:paddingBottom="28dp">

                <TextView
                    style="@style/Texto.Eyebrow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Punto de venta" />

                <TextView
                    style="@style/Texto.Hero"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Nueva venta" />
            </LinearLayout>

            <!-- ===== Hoja blanca con el formulario ===== -->
            <LinearLayout
                android:id="@+id/hoja"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:background="@drawable/bg_hoja"
                android:divider="@drawable/espacio"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingTop="26dp"
                android:paddingEnd="20dp"
                android:paddingBottom="16dp"
                android:showDividers="middle">

                <TextView
                    style="@style/Texto.Seccion"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="Cliente" />

                <Spinner
                    android:id="@+id/spPaciente"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <TextView
                    style="@style/Texto.Seccion"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_marginTop="8dp"
                    android:text="Agregar producto" />

                <Spinner
                    android:id="@+id/spProducto"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <EditText
                        android:id="@+id/etCantidad"
                        android:maxLength="3"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="10dp"
                        android:layout_weight="1"
                        android:hint="Cantidad"
                        android:importantForAutofill="no"
                        android:inputType="number"
                        android:text="1" />

                    <Button
                        android:id="@+id/btnAgregar"
                        style="@style/Boton.Secundario"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minHeight="54dp"
                        android:text="Agregar"
                        app:icon="@drawable/ic_agregar" />
                </LinearLayout>

                <!-- Carrito en una tarjeta lila clara -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                style="@style/Texto.Seccion"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Productos" />

                            <TextView
                                style="@style/Texto.Categoria"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Toca uno para quitarlo" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvCarritoVacio"
                            style="@style/Texto.Secundario"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:text="Aún no agregas productos" />

                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/rvCarrito"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:nestedScrollingEnabled="false"
                            tools:itemCount="3"
                            tools:listitem="@layout/item_carrito" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <TextView
                    style="@style/Texto.Seccion"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_marginTop="8dp"
                    android:text="Pago" />

                <!-- Método de pago con pestañas subrayadas -->
                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:scrollbars="none">

                    <RadioGroup
                        android:id="@+id/rgMetodo"
                        style="@style/Segmentos"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingStart="4dp">

                        <RadioButton
                            android:id="@+id/rbEfectivo"
                            style="@style/Segmento"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checked="true"
                            android:text="Efectivo" />

                        <RadioButton
                            android:id="@+id/rbTarjeta"
                            style="@style/Segmento"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Tarjeta" />

                        <RadioButton
                            android:id="@+id/rbTransferencia"
                            style="@style/Segmento"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Transferencia" />
                    </RadioGroup>
                </HorizontalScrollView>

                <EditText
                    android:id="@+id/etAnticipo"
                    android:maxLength="10"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Anticipo ($). Vacío = paga todo"
                    android:importantForAutofill="no"
                    android:inputType="numberDecimal" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp">

                    <TextView
                        style="@style/Texto.Secundario"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Saldo pendiente" />

                    <TextView
                        android:id="@+id/tvSaldo"
                        style="@style/Texto.Valor"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/naranja"
                        tools:text="$1,580.00" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/borde" />

                <!-- Switch azul cielo -->
                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/swOrden"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="4dp"
                    android:text="Enviar orden al laboratorio"
                    android:textSize="14sp" />

                <EditText
                    android:id="@+id/etOrdenDescripcion"
                    android:maxLength="200"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Trabajo (ej. Mica progresiva AR)"
                    android:importantForAutofill="no"
                    android:inputType="textCapSentences"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- ===== Pie fijo: total y botón azul cielo ===== -->
    <LinearLayout
        android:id="@+id/pie"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/superficie"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="24dp"
        android:paddingTop="12dp"
        android:paddingEnd="20dp"
        android:paddingBottom="16dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                style="@style/Texto.Categoria"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Total" />

            <TextView
                android:id="@+id/tvTotal"
                style="@style/Texto.Precio"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="$0.00"
                android:textSize="20sp"
                tools:text="$2,580.00" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/progreso"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginStart="12dp"
            android:indeterminateTint="@color/cielo"
            android:visibility="gone" />

        <Button
            android:id="@+id/btnConfirmar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_weight="1"
            android:text="Cobrar" />
    </LinearLayout>
</LinearLayout>
