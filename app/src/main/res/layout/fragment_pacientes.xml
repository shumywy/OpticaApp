<?xml version="1.0" encoding="utf-8"?>
<!-- Pantalla 4: Pacientes -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="4dp"
        android:paddingEnd="16dp">

        <EditText
            android:id="@+id/etBuscar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:drawableStart="@drawable/ic_buscar"
            android:drawablePadding="12dp"
            android:drawableTint="@color/texto_secundario"
            android:hint="Buscar por nombre o teléfono"
            android:importantForAutofill="no"
            android:inputType="text" />

        <!-- Control segmentado para ordenar -->
        <RadioGroup
            android:id="@+id/rgOrden"
            style="@style/Segmentos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp">

            <RadioButton
                android:id="@+id/rbRecientes"
                style="@style/Segmento"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:checked="true"
                android:text="Recientes" />

            <RadioButton
                android:id="@+id/rbNombre"
                style="@style/Segmento"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Nombre (A-Z)" />
        </RadioGroup>

        <TextView
            android:id="@+id/tvVacio"
            style="@style/Texto.Secundario"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="32dp"
            android:text="Todavía no hay pacientes registrados"
            android:visibility="gone" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvPacientes"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="8dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingBottom="88dp"
            tools:itemCount="5"
            tools:listitem="@layout/item_paciente" />
    </LinearLayout>

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabAgregar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="16dp"
        android:contentDescription="Agregar paciente"
        android:src="@drawable/ic_agregar" />
</FrameLayout>
