<?xml version="1.0" encoding="utf-8"?>
<!-- Pantalla 4: Pacientes. Buscador y título sobre el degradado; la lista va en la hoja blanca. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- ===== Encabezado sobre el degradado ===== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingBottom="24dp">

        <EditText
            android:id="@+id/etBuscar"
            style="@style/Campo.Busqueda"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Buscar por nombre o teléfono"
            android:importantForAutofill="no" />

        <TextView
            style="@style/Texto.Eyebrow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="Expedientes" />

        <TextView
            style="@style/Texto.Hero"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Pacientes" />
    </LinearLayout>

    <!-- ===== Hoja blanca con la lista ===== -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@drawable/bg_hoja">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="24dp"
            android:paddingEnd="20dp">

            <TextView
                style="@style/Texto.Seccion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="Lista de pacientes" />

            <!-- Pestañas subrayadas para ordenar -->
            <RadioGroup
                android:id="@+id/rgOrden"
                style="@style/Segmentos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginTop="8dp">

                <RadioButton
                    android:id="@+id/rbRecientes"
                    style="@style/Segmento"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="Recientes" />

                <RadioButton
                    android:id="@+id/rbNombre"
                    style="@style/Segmento"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Nombre A-Z" />
            </RadioGroup>

            <TextView
                android:id="@+id/tvVacio"
                style="@style/Texto.Secundario"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="32dp"
                android:text="Todavía no hay pacientes registrados"
                android:visibility="gone" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvPacientes"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="4dp"
                android:layout_weight="1"
                android:clipToPadding="false"
                android:paddingBottom="96dp"
                tools:itemCount="5"
                tools:listitem="@layout/item_paciente" />
        </LinearLayout>

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fabAgregar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_margin="20dp"
            android:contentDescription="Agregar paciente"
            android:src="@drawable/ic_agregar" />
    </FrameLayout>
</LinearLayout>
