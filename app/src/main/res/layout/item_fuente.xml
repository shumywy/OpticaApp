<?xml version="1.0" encoding="utf-8"?>
<!--
    Tarjeta de una tipografía en Ajustes › Apariencia (como en la app Atrium): "Aa" grande, nombre y
    descripción escritos con esa misma fuente. El contorno de la elegida lo pone AjustesFragment.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/raizFuente"
    android:layout_width="148dp"
    android:layout_height="wrap_content"
    android:layout_marginEnd="10dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    android:orientation="vertical"
    android:padding="14dp">

    <TextView
        android:id="@+id/tvMuestraFuente"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:includeFontPadding="false"
        android:text="Aa"
        android:textColor="?attr/colorAcento"
        android:textSize="34sp" />

    <TextView
        android:id="@+id/tvNombreFuente"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="?attr/colorTexto"
        android:textSize="15sp"
        tools:text="Inter" />

    <TextView
        android:id="@+id/tvDescripcionFuente"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="?attr/colorTextoSecundario"
        android:textSize="12sp"
        tools:text="Moderna · corporativa" />
</LinearLayout>
