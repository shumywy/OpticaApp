<?xml version="1.0" encoding="utf-8"?>
<!--
    Renglón de un paciente como ficha de expediente:
    nombre en negritas y fecha de la última consulta arriba, teléfono debajo
    y la graduación en una insignia (lila si tiene, gris si no).
-->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="10dp"
    app:cardBackgroundColor="@color/superficie"
    app:cardCornerRadius="18dp"
    app:strokeColor="@color/borde"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/selectableItemBackground"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="14dp"
        android:paddingEnd="16dp"
        android:paddingBottom="14dp">

        <!-- Nombre (izquierda) y última consulta (derecha) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="true"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvNombre"
                style="@style/Texto.Fila"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="@font/lexend_semibold"
                android:maxLines="1"
                android:textSize="16sp"
                tools:text="María Fernanda López" />

            <TextView
                android:id="@+id/tvFecha"
                style="@style/Texto.Etiqueta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:maxLines="1"
                tools:text="Últ. consulta 7 oct" />
        </LinearLayout>

        <!-- Teléfono con ícono pequeño -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_telefono"
                app:tint="@color/texto_secundario" />

            <TextView
                android:id="@+id/tvTelefono"
                style="@style/Texto.Secundario"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:maxLines="1"
                tools:text="747 123 4567" />
        </LinearLayout>

        <!-- Graduación en insignia: el fondo y el color los pone PacientesAdapter -->
        <TextView
            android:id="@+id/tvGraduacion"
            style="@style/Texto.Pildora"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_pildora_morado"
            android:textColor="@color/morado"
            tools:text="OD -1.25 / OI -1.50" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
