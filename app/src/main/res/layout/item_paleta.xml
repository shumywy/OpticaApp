<?xml version="1.0" encoding="utf-8"?>
<!--
    Tarjeta de un tema en Ajustes › Apariencia: sus tres colores (primario, secundario y terciario),
    nombre, etiqueta "Actual", lema y palomita si está elegido. La elegida se despliega con sus
    colores núcleo y el botón "Ver esquema completo" (como en la app Atrium). El contorno, los
    colores y el detalle los pone AjustesFragment.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/raizPaleta"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    android:animateLayoutChanges="true"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingTop="10dp"
    android:paddingEnd="12dp"
    android:paddingBottom="10dp">

    <LinearLayout
        android:id="@+id/filaPaleta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:minHeight="44dp"
        android:orientation="horizontal">

    <LinearLayout
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/bg_franjas"
        android:clipToOutline="true"
        android:importantForAccessibility="no"
        android:orientation="horizontal">

        <View
            android:id="@+id/franjaPrimario"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1" />

        <View
            android:id="@+id/franjaSecundario"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1" />

        <View
            android:id="@+id/franjaTerciario"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvNombrePaleta"
                style="@style/Texto.Fila"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                tools:text="Cristal" />

            <TextView
                android:id="@+id/tvActual"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_etiqueta_actual"
                android:fontFamily="?attr/fuenteMedia"
                android:paddingStart="6dp"
                android:paddingTop="1dp"
                android:paddingEnd="6dp"
                android:paddingBottom="1dp"
                android:text="Actual"
                android:textColor="?attr/colorTextoSecundario"
                android:textSize="10sp"
                android:visibility="gone"
                tools:visibility="visible" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvLemaPaleta"
            style="@style/Texto.Secundario"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:textSize="12sp"
            tools:text="Azul cielo · Violeta · Rosa" />
    </LinearLayout>

    <ImageView
        android:id="@+id/ivElegida"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginStart="10dp"
        android:importantForAccessibility="no"
        android:padding="4dp"
        android:src="@drawable/ic_check" />
    </LinearLayout>

    <!-- Detalle del tema elegido: colores núcleo y acceso al esquema completo -->
    <LinearLayout
        android:id="@+id/detallePaleta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone"
        tools:visibility="visible">

        <TextView
            style="@style/Texto.Categoria"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="Colores núcleo" />

        <!-- Seis columnas: muestra redonda, nombre y código (las agrega AjustesFragment) -->
        <LinearLayout
            android:id="@+id/filaNucleo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnVerEsquema"
            style="@style/Widget.Material3.Button.TextButton.Icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginTop="4dp"
            android:text="Ver esquema completo"
            app:icon="@drawable/ic_paleta" />
    </LinearLayout>
</LinearLayout>
