<?xml version="1.0" encoding="utf-8"?>
<!-- Un color núcleo en Esquema de color: muestra redonda, nombre, de dónde sale y código -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:minHeight="58dp"
    android:orientation="horizontal"
    android:paddingStart="14dp"
    android:paddingTop="8dp"
    android:paddingEnd="14dp"
    android:paddingBottom="8dp">

    <View
        android:id="@+id/muestraNucleo"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:background="@drawable/bg_circulo"
        android:importantForAccessibility="no" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvNombreNucleo"
            style="@style/Texto.Fila"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            tools:text="Primary" />

        <TextView
            android:id="@+id/tvOrigenNucleo"
            style="@style/Texto.Secundario"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            tools:text="Acento del tema" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvHexNucleo"
        style="@style/Texto.Categoria"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="monospace"
        tools:text="#3BB4F2" />
</LinearLayout>
