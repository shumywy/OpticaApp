<?xml version="1.0" encoding="utf-8"?>
<!-- Renglón del historial de un producto: tipo, qué cambió, fecha y usuario, y el cambio en existencias -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingTop="12dp"
    android:paddingBottom="12dp">

    <FrameLayout
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:background="@drawable/bg_avatar">

        <ImageView
            android:id="@+id/ivTipo"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_gravity="center"
            android:importantForAccessibility="no"
            app:tint="@color/menu_icono"
            tools:src="@drawable/ic_ventas" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvTipo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/lexend_medium"
            android:textColor="@color/texto"
            android:textSize="14sp"
            tools:text="Venta" />

        <TextView
            android:id="@+id/tvDescripcion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="@font/lexend_regular"
            android:lineSpacingMultiplier="1.2"
            android:textColor="@color/texto_secundario"
            android:textSize="12sp"
            tools:text="Venta de 1 × Paño Twins · Gris Oxford a $50.00 · cliente: Ana Ruiz" />

        <TextView
            android:id="@+id/tvFecha"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="@font/lexend_regular"
            android:textColor="@color/texto_tenue"
            android:textSize="11sp"
            tools:text="20/10/2026 18:42 · Fernanda Mancilla" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:gravity="end"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvCantidad"
            style="@style/Texto.Pildora"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_pildora_rojo"
            android:textColor="@color/rojo"
            tools:text="−1" />

        <TextView
            android:id="@+id/tvExistencias"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="@font/lexend_regular"
            android:textColor="@color/texto_tenue"
            android:textSize="11sp"
            tools:text="Quedan 9" />
    </LinearLayout>
</LinearLayout>
