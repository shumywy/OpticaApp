<?xml version="1.0" encoding="utf-8"?>
<!-- Pantalla 3: Panel principal -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Encabezado: tarjeta con foto y saludo + botón de avisos -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="16dp">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/tarjetaPerfil"
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                app:cardCornerRadius="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp">

                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/ivAvatar"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="@color/icono_fondo"
                        android:contentDescription="Foto de perfil"
                        android:scaleType="centerCrop"
                        app:shapeAppearanceOverlay="@style/Forma.Circulo" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvSaludo"
                            style="@style/Texto.Etiqueta"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            tools:text="¡Buenos días!" />

                        <TextView
                            android:id="@+id/tvNombre"
                            style="@style/Texto.Fila"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:maxLines="1"
                            tools:text="Laura Martínez" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/tarjetaAvisos"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_marginStart="10dp"
                android:clickable="true"
                android:contentDescription="Avisos"
                android:focusable="true"
                app:cardCornerRadius="16dp">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="center"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_campana"
                        app:tint="@color/texto" />

                    <View
                        android:id="@+id/puntoAvisos"
                        android:layout_width="8dp"
                        android:layout_height="8dp"
                        android:layout_gravity="top|end"
                        android:layout_marginTop="18dp"
                        android:layout_marginEnd="20dp"
                        android:background="@drawable/bg_punto_rojo"
                        android:visibility="gone" />
                </FrameLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <TextView
            android:id="@+id/tvOptica"
            style="@style/Texto.Secundario"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            tools:text="Óptica Vista Clara · Administrador" />

        <!-- Avance semanal (Administrador y Vendedor) -->
        <LinearLayout
            android:id="@+id/layoutAvance"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingTop="16dp">

            <FrameLayout
                android:layout_width="200dp"
                android:layout_height="200dp">

                <com.google.android.material.progressindicator.CircularProgressIndicator
                    android:id="@+id/barraAvance"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:max="100"
                    app:indicatorColor="@color/azul"
                    app:indicatorSize="184dp"
                    app:trackColor="@color/borde"
                    app:trackCornerRadius="8dp"
                    app:trackThickness="14dp"
                    tools:progress="68" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvAvancePorcentaje"
                        style="@style/Texto.Titulo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="36sp"
                        tools:text="68 %" />

                    <TextView
                        style="@style/Texto.Etiqueta"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Avance semanal" />
                </LinearLayout>
            </FrameLayout>

            <TextView
                android:id="@+id/tvAvanceMonto"
                style="@style/Texto.Fila"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                tools:text="$20,400.00 de $30,000.00" />

            <TextView
                android:id="@+id/tvFaltante"
                style="@style/Texto.Secundario"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                tools:text="Faltan $9,600.00 · quedan 3 días" />
        </LinearLayout>

        <!-- Panel blanco inferior con los indicadores -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="24dp"
            android:layout_weight="1"
            android:background="@drawable/bg_hoja"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingTop="20dp"
            android:paddingEnd="12dp"
            android:paddingBottom="16dp">

            <TextView
                style="@style/Texto.Seccion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginBottom="12dp"
                android:text="Resumen de hoy" />

            <!-- Fila 1 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/tileVentas"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:padding="8dp">

                    <ImageView
                        style="@style/IconoPanel"
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_dinero" />

                    <TextView
                        android:id="@+id/tvVentasHoy"
                        style="@style/Texto.Valor"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="—"
                        tools:text="$3,250.00" />

                    <TextView
                        style="@style/Texto.Etiqueta"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Ventas de hoy" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/tilePacientes"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:padding="8dp">

                    <ImageView
                        style="@style/IconoPanel"
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_pacientes" />

                    <TextView
                        android:id="@+id/tvPacientesHoy"
                        style="@style/Texto.Valor"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="—"
                        tools:text="6" />

                    <TextView
                        style="@style/Texto.Etiqueta"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Pacientes hoy" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/tileOrdenes"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:padding="8dp">

                    <ImageView
                        style="@style/IconoPanel"
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_laboratorio" />

                    <TextView
                        android:id="@+id/tvOrdenes"
                        style="@style/Texto.Valor"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="—"
                        tools:text="4" />

                    <TextView
                        style="@style/Texto.Etiqueta"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="En laboratorio" />
                </LinearLayout>
            </LinearLayout>

            <!-- Fila 2 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/tileStock"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:padding="8dp">

                    <ImageView
                        style="@style/IconoPanel"
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_alerta" />

                    <TextView
                        android:id="@+id/tvStockBajo"
                        style="@style/Texto.Valor"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="—"
                        tools:text="3" />

                    <TextView
                        style="@style/Texto.Etiqueta"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Stock bajo" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/tileMeta"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:padding="8dp">

                    <ImageView
                        style="@style/IconoPanel"
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_meta" />

                    <TextView
                        android:id="@+id/tvMeta"
                        style="@style/Texto.Valor"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="—"
                        tools:text="$30,000.00" />

                    <TextView
                        style="@style/Texto.Etiqueta"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Meta semanal" />
                </LinearLayout>

                <!-- Acción rápida (círculo azul): nueva venta o, para el optometrista, pacientes -->
                <LinearLayout
                    android:id="@+id/tileAccion"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:padding="8dp">

                    <ImageView
                        android:id="@+id/ivAccion"
                        style="@style/IconoPanel.Activo"
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_ventas" />

                    <TextView
                        android:id="@+id/tvAccion"
                        style="@style/Texto.Valor"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Nueva" />

                    <TextView
                        android:id="@+id/tvAccionEtiqueta"
                        style="@style/Texto.Etiqueta"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="venta" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
