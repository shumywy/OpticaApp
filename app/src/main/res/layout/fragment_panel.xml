<?xml version="1.0" encoding="utf-8"?>
<!--
    Pantalla 3: Panel principal, al estilo "Chimi Eyewear / Collection":
    íconos arriba, saludo y nombre grandes sobre el degradado, tarjeta translúcida
    con el avance semanal y una hoja blanca con mosaicos lila.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- ===== Íconos de arriba: menú (⁘), avisos y foto ===== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="16dp">

            <ImageView
                android:id="@+id/tarjetaMenu"
                style="@style/BotonIcono"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:contentDescription="@string/menu_abrir"
                android:src="@drawable/ic_puntos" />

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <FrameLayout
                android:id="@+id/tarjetaAvisos"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:contentDescription="Avisos"
                android:focusable="true">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_campana"
                    app:tint="@color/texto" />

                <View
                    android:id="@+id/puntoAvisos"
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:layout_gravity="top|end"
                    android:layout_marginTop="12dp"
                    android:layout_marginEnd="12dp"
                    android:background="@drawable/bg_punto_rojo"
                    android:visibility="gone" />
            </FrameLayout>

            <!-- Foto: abre Perfil y ajustes -->
            <FrameLayout
                android:id="@+id/tarjetaPerfil"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="6dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:contentDescription="Perfil y ajustes"
                android:focusable="true">

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/ivAvatar"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@color/superficie"
                    android:importantForAccessibility="no"
                    android:padding="1.5dp"
                    android:scaleType="centerCrop"
                    app:shapeAppearanceOverlay="@style/Forma.Circulo"
                    app:strokeColor="@color/superficie"
                    app:strokeWidth="2dp" />
            </FrameLayout>
        </LinearLayout>

        <!-- ===== Saludo y nombre (como "Chimi Eyewear / Collection") ===== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingTop="12dp"
            android:paddingEnd="24dp">

            <TextView
                android:id="@+id/tvSaludo"
                style="@style/Texto.Eyebrow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                tools:text="¡Buenas tardes!" />

            <TextView
                android:id="@+id/tvNombre"
                style="@style/Texto.Hero"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:maxLines="2"
                tools:text="Laura Martínez" />

            <TextView
                android:id="@+id/tvOptica"
                style="@style/Texto.Categoria"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                tools:text="Óptica Vista Clara · Administrador" />
        </LinearLayout>

        <!-- ===== Avance semanal (Administrador y Vendedor) en una tarjeta translúcida ===== -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/layoutAvance"
            style="@style/Tarjeta.Cristal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginTop="20dp"
            android:layout_marginEnd="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/Texto.Categoria"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Avance semanal" />

                        <TextView
                            android:id="@+id/tvAvanceMonto"
                            style="@style/Texto.Fila"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            tools:text="$20,400.00 de $30,000.00" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvAvancePorcentaje"
                        style="@style/Texto.Precio"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        tools:text="68 %" />
                </LinearLayout>

                <com.google.android.material.progressindicator.LinearProgressIndicator
                    android:id="@+id/barraAvance"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:max="100"
                    app:indicatorColor="@color/cielo"
                    app:trackColor="@color/lavanda"
                    app:trackCornerRadius="4dp"
                    app:trackThickness="8dp"
                    tools:progress="68" />

                <TextView
                    android:id="@+id/tvFaltante"
                    style="@style/Texto.Secundario"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    tools:text="Faltan $9,600.00 · quedan 3 días" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ===== Hoja blanca con los indicadores ===== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="28dp"
            android:layout_weight="1"
            android:background="@drawable/bg_hoja"
            android:divider="@drawable/espacio"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="26dp"
            android:paddingEnd="20dp"
            android:paddingBottom="20dp"
            android:showDividers="middle">

            <!-- Título de sección con el contador "HOY ━──" a la derecha, como "Best Selling 01/20" -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginBottom="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/Texto.Seccion"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Resumen de hoy" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Texto.Contador"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="HOY" />

                    <View
                        android:layout_width="96dp"
                        android:layout_height="6dp"
                        android:layout_marginTop="4dp"
                        android:background="@drawable/bg_linea_contador" />
                </LinearLayout>
            </LinearLayout>

            <!-- Fila 1: ventas | pacientes (los que el rol no usa se ocultan y el otro ocupa todo el ancho) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:divider="@drawable/espacio"
                android:orientation="horizontal"
                android:showDividers="middle">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/tileVentas"
                    style="@style/Tarjeta.Mosaico"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <ImageView
                            style="@style/IconoPanel"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_dinero" />

                        <TextView
                            android:id="@+id/tvVentasHoy"
                            style="@style/Texto.Valor"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="18dp"
                            android:text="—"
                            android:textSize="16sp"
                            tools:text="$3,250.00" />

                        <TextView
                            style="@style/Texto.Etiqueta"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Ventas de hoy" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/tilePacientes"
                    style="@style/Tarjeta.Mosaico"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <ImageView
                            style="@style/IconoPanel"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_pacientes" />

                        <TextView
                            android:id="@+id/tvPacientesHoy"
                            style="@style/Texto.Valor"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="18dp"
                            android:text="—"
                            android:textSize="16sp"
                            tools:text="6" />

                        <TextView
                            style="@style/Texto.Etiqueta"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Pacientes hoy" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- Fila 2: laboratorio | stock bajo -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:divider="@drawable/espacio"
                android:orientation="horizontal"
                android:showDividers="middle">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/tileOrdenes"
                    style="@style/Tarjeta.Mosaico"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <ImageView
                            style="@style/IconoPanel"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_laboratorio" />

                        <TextView
                            android:id="@+id/tvOrdenes"
                            style="@style/Texto.Valor"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="18dp"
                            android:text="—"
                            android:textSize="16sp"
                            tools:text="4" />

                        <TextView
                            style="@style/Texto.Etiqueta"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="En laboratorio" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/tileStock"
                    style="@style/Tarjeta.Mosaico"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <ImageView
                            style="@style/IconoPanel"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_alerta" />

                        <TextView
                            android:id="@+id/tvStockBajo"
                            style="@style/Texto.Valor"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="18dp"
                            android:text="—"
                            android:textSize="16sp"
                            tools:text="3" />

                        <TextView
                            style="@style/Texto.Etiqueta"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Stock bajo" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- Fila 3: meta | acción rápida (azul cielo) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:divider="@drawable/espacio"
                android:orientation="horizontal"
                android:showDividers="middle">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/tileMeta"
                    style="@style/Tarjeta.Mosaico"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <ImageView
                            style="@style/IconoPanel"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_meta" />

                        <TextView
                            android:id="@+id/tvMeta"
                            style="@style/Texto.Valor"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="18dp"
                            android:text="—"
                            android:textSize="16sp"
                            tools:text="$30,000.00" />

                        <TextView
                            style="@style/Texto.Etiqueta"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Meta semanal" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Acción rápida: nueva venta o, para el optometrista, expedientes -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/tileAccion"
                    style="@style/Tarjeta.Mosaico"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true"
                    app:cardBackgroundColor="@color/cielo">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <ImageView
                            android:id="@+id/ivAccion"
                            style="@style/IconoPanel"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_ventas"
                            app:tint="@color/cielo" />

                        <TextView
                            android:id="@+id/tvAccion"
                            style="@style/Texto.Valor"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="18dp"
                            android:text="Nueva"
                            android:textColor="@color/blanco"
                            android:textSize="16sp" />

                        <TextView
                            android:id="@+id/tvAccionEtiqueta"
                            style="@style/Texto.Etiqueta"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="venta"
                            android:textColor="@color/blanco" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
