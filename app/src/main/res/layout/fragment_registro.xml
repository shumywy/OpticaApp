<?xml version="1.0" encoding="utf-8"?>
<!-- Pantalla 2: Registro de óptica / unirse con código -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- ===== Encabezado sobre el degradado ===== -->
        <LinearLayout
            android:id="@+id/encabezado"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="28dp"
            android:paddingTop="4dp"
            android:paddingEnd="28dp"
            android:paddingBottom="28dp">

            <TextView
                style="@style/Texto.Eyebrow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Óptica App" />

            <TextView
                style="@style/Texto.Hero"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Crear cuenta" />
        </LinearLayout>

        <!-- ===== Hoja blanca ===== -->
        <LinearLayout
            android:id="@+id/hoja"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@drawable/bg_hoja"
            android:divider="@drawable/espacio"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingTop="26dp"
            android:paddingEnd="24dp"
            android:paddingBottom="24dp"
            android:showDividers="middle">

            <!-- Pestañas: qué quiere hacer el usuario -->
            <RadioGroup
                android:id="@+id/rgModo"
                style="@style/Segmentos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <RadioButton
                    android:id="@+id/rbNueva"
                    style="@style/Segmento"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Registrar mi óptica" />

                <RadioButton
                    android:id="@+id/rbUnirme"
                    style="@style/Segmento"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Unirme con código" />
            </RadioGroup>

            <!-- Datos de la cuenta -->
            <TextView
                style="@style/Texto.Seccion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Tu cuenta" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilNombre"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Nombre completo">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etNombre"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:maxLength="60"
                    android:autofillHints="name"
                    android:inputType="textPersonName|textCapWords" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Se oculta cuando el usuario ya entró con Google y solo completa sus datos -->
            <LinearLayout
                android:id="@+id/layoutCuenta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:divider="@drawable/espacio"
                android:orientation="vertical"
                android:showDividers="middle">

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilCorreo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Correo electrónico">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etCorreo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:maxLength="100"
                        android:autofillHints="emailAddress"
                        android:inputType="textEmailAddress" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilContrasena"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Contraseña"
                    app:endIconMode="password_toggle">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etContrasena"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:maxLength="64"
                        android:autofillHints="newPassword"
                        android:inputType="textPassword" />
                </com.google.android.material.textfield.TextInputLayout>

                <TextView
                    android:id="@+id/tvReglas"
                    style="@style/Texto.Secundario"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="4dp" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilConfirmar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Confirmar contraseña"
                    app:endIconMode="password_toggle">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etConfirmar"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:maxLength="64"
                        android:autofillHints="newPassword"
                        android:inputType="textPassword" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>

            <!-- Datos de una óptica nueva -->
            <LinearLayout
                android:id="@+id/layoutNueva"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:divider="@drawable/espacio"
                android:orientation="vertical"
                android:showDividers="middle">

                <TextView
                    style="@style/Texto.Seccion"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Datos de la óptica" />

                <!-- Logotipo en un mosaico lila, igual que las fotos de productos -->
                <com.google.android.material.card.MaterialCardView
                    style="@style/Tarjeta.Mosaico"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="14dp">

                        <com.google.android.material.imageview.ShapeableImageView
                            android:id="@+id/ivLogo"
                            android:layout_width="72dp"
                            android:layout_height="72dp"
                            android:background="@color/superficie"
                            android:contentDescription="Logotipo de la óptica"
                            android:padding="20dp"
                            android:scaleType="centerCrop"
                            android:src="@drawable/ic_camara"
                            app:shapeAppearanceOverlay="@style/Forma.Circulo"
                            app:tint="@color/texto_secundario" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="14dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                style="@style/Texto.Categoria"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="12dp"
                                android:text="Logotipo" />

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal">

                                <Button
                                    android:id="@+id/btnLogoCamara"
                                    style="@style/Boton.Texto"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Tomar foto" />

                                <Button
                                    android:id="@+id/btnLogoGaleria"
                                    style="@style/Boton.Texto"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Galería" />
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilOpticaNombre"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Nombre comercial">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etOpticaNombre"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:maxLength="60"
                        android:importantForAutofill="no"
                        android:inputType="textCapWords" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilTelefono"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Teléfono"
                    app:counterEnabled="true"
                    app:counterMaxLength="10">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etTelefono"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:maxLength="10"
                        android:digits="0123456789"
                        android:autofillHints="phone"
                        android:inputType="phone" />
                </com.google.android.material.textfield.TextInputLayout>

                <Spinner
                    android:id="@+id/spEstado"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilDireccion"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Dirección"
                    app:counterEnabled="true"
                    app:counterMaxLength="150">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etDireccion"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:maxLength="150"
                        android:autofillHints="postalAddress"
                        android:inputType="textPostalAddress" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilMeta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Meta de ventas semanal"
                    app:prefixText="$">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etMeta"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:maxLength="10"
                        android:importantForAutofill="no"
                        android:inputType="numberDecimal" />
                </com.google.android.material.textfield.TextInputLayout>

                <TextView
                    style="@style/Texto.Secundario"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Al terminar se generará un código de invitación para que tu personal se una a esta óptica." />
            </LinearLayout>

            <!-- Unirse a una óptica existente -->
            <LinearLayout
                android:id="@+id/layoutUnirme"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:divider="@drawable/espacio"
                android:orientation="vertical"
                android:showDividers="middle"
                android:visibility="gone">

                <TextView
                    style="@style/Texto.Seccion"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Código de invitación" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilCodigo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Código de invitación"
                    app:startIconDrawable="@drawable/ic_llave"
                    app:placeholderText="OPT-7K2Q9X">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etCodigo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:maxLength="10"
                        android:digits="ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-"
                        android:importantForAutofill="no"
                        android:inputType="textCapCharacters" />
                </com.google.android.material.textfield.TextInputLayout>

                <TextView
                    style="@style/Texto.Categoria"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Tu puesto en la óptica" />

                <Spinner
                    android:id="@+id/spRol"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <Button
                android:id="@+id/btnContinuar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Continuar" />

            <ProgressBar
                android:id="@+id/progreso"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:indeterminateTint="@color/cielo"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
