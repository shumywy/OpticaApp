<?xml version="1.0" encoding="utf-8"?>
<!-- Pantalla 2: Registro de óptica / unirse con código -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- ===== Encabezado sobre el degradado ===== -->
        <LinearLayout
            android:id="@+id/encabezado"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="28dp"
            android:paddingTop="4dp"
            android:paddingEnd="28dp"
            android:paddingBottom="28dp">

            <TextView
                style="@style/Texto.Eyebrow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Óptica App" />

            <TextView
                style="@style/Texto.Hero"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Crear cuenta" />
        </LinearLayout>

        <!-- ===== Hoja blanca ===== -->
        <LinearLayout
            android:id="@+id/hoja"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@drawable/bg_hoja"
            android:divider="@drawable/espacio"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingTop="26dp"
            android:paddingEnd="24dp"
            android:paddingBottom="24dp"
            android:showDividers="middle">

            <!-- Pestañas: qué quiere hacer el usuario -->
            <RadioGroup
                android:id="@+id/rgModo"
                style="@style/Segmentos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <RadioButton
                    android:id="@+id/rbNueva"
                    style="@style/Segmento"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Registrar mi óptica" />

                <RadioButton
                    android:id="@+id/rbUnirme"
                    style="@style/Segmento"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Unirme con código" />
            </RadioGroup>

            <!-- Datos de la cuenta -->
            <TextView
                style="@style/Texto.Seccion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Tu cuenta" />

            <EditText
                android:id="@+id/etNombre"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:autofillHints="name"
                android:hint="Nombre completo"
                android:inputType="textPersonName|textCapWords" />

            <!-- Se oculta cuando el usuario ya entró con Google y solo completa sus datos -->
            <LinearLayout
                android:id="@+id/layoutCuenta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:divider="@drawable/espacio"
                android:orientation="vertical"
                android:showDividers="middle">

                <EditText
                    android:id="@+id/etCorreo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:autofillHints="emailAddress"
                    android:hint="Correo electrónico"
                    android:inputType="textEmailAddress" />

                <EditText
                    android:id="@+id/etContrasena"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:autofillHints="newPassword"
                    android:hint="Contraseña"
                    android:inputType="textPassword" />

                <TextView
                    android:id="@+id/tvReglas"
                    style="@style/Texto.Secundario"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="4dp" />

                <EditText
                    android:id="@+id/etConfirmar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:autofillHints="newPassword"
                    android:hint="Confirmar contraseña"
                    android:inputType="textPassword" />
            </LinearLayout>

            <!-- Datos de una óptica nueva -->
            <LinearLayout
                android:id="@+id/layoutNueva"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:divider="@drawable/espacio"
                android:orientation="vertical"
                android:showDividers="middle">

                <TextView
                    style="@style/Texto.Seccion"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Datos de la óptica" />

                <!-- Logotipo en un mosaico lila, como los productos del diseño -->
                <com.google.android.material.card.MaterialCardView
                    style="@style/Tarjeta.Mosaico"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="14dp">

                        <com.google.android.material.imageview.ShapeableImageView
                            android:id="@+id/ivLogo"
                            android:layout_width="72dp"
                            android:layout_height="72dp"
                            android:background="@color/superficie"
                            android:contentDescription="Logotipo de la óptica"
                            android:padding="20dp"
                            android:scaleType="centerCrop"
                            android:src="@drawable/ic_camara"
                            app:shapeAppearanceOverlay="@style/Forma.Circulo"
                            app:tint="@color/texto_secundario" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="14dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                style="@style/Texto.Categoria"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="12dp"
                                android:text="Logotipo" />

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal">

                                <Button
                                    android:id="@+id/btnLogoCamara"
                                    style="@style/Boton.Texto"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Tomar foto" />

                                <Button
                                    android:id="@+id/btnLogoGaleria"
                                    style="@style/Boton.Texto"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Galería" />
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <EditText
                    android:id="@+id/etOpticaNombre"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Nombre comercial"
                    android:importantForAutofill="no"
                    android:inputType="textCapWords" />

                <EditText
                    android:id="@+id/etTelefono"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:autofillHints="phone"
                    android:hint="Teléfono"
                    android:inputType="phone" />

                <Spinner
                    android:id="@+id/spEstado"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <EditText
                    android:id="@+id/etDireccion"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:autofillHints="postalAddress"
                    android:hint="Dirección"
                    android:inputType="textPostalAddress" />

                <EditText
                    android:id="@+id/etMeta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Meta de ventas semanal ($)"
                    android:importantForAutofill="no"
                    android:inputType="numberDecimal" />

                <TextView
                    style="@style/Texto.Secundario"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Al terminar se generará un código de invitación para que tu personal se una a esta óptica." />
            </LinearLayout>

            <!-- Unirse a una óptica existente -->
            <LinearLayout
                android:id="@+id/layoutUnirme"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:divider="@drawable/espacio"
                android:orientation="vertical"
                android:showDividers="middle"
                android:visibility="gone">

                <TextView
                    style="@style/Texto.Seccion"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Código de invitación" />

                <EditText
                    android:id="@+id/etCodigo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:drawableStart="@drawable/ic_llave"
                    android:drawablePadding="12dp"
                    android:drawableTint="@color/texto_secundario"
                    android:hint="Ej. OPT-7K2Q9X"
                    android:importantForAutofill="no"
                    android:inputType="textCapCharacters" />

                <TextView
                    style="@style/Texto.Categoria"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Tu puesto en la óptica" />

                <Spinner
                    android:id="@+id/spRol"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <Button
                android:id="@+id/btnContinuar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Continuar" />

            <ProgressBar
                android:id="@+id/progreso"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:indeterminateTint="@color/cielo"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
