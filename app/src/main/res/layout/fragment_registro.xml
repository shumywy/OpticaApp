<?xml version="1.0" encoding="utf-8"?>
<!-- Pantalla 2: Registro de óptica / unirse con código -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:divider="@drawable/espacio"
        android:orientation="vertical"
        android:padding="16dp"
        android:showDividers="middle">

        <!-- Control segmentado: qué quiere hacer el usuario -->
        <RadioGroup
            android:id="@+id/rgModo"
            style="@style/Segmentos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <RadioButton
                android:id="@+id/rbNueva"
                style="@style/Segmento"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Registrar mi óptica" />

            <RadioButton
                android:id="@+id/rbUnirme"
                style="@style/Segmento"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Unirme con código" />
        </RadioGroup>

        <!-- Tarjeta: datos de la cuenta -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:divider="@drawable/espacio"
                android:orientation="vertical"
                android:padding="16dp"
                android:showDividers="middle">

                <TextView
                    style="@style/Texto.Seccion"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tu cuenta" />

                <EditText
                    android:id="@+id/etNombre"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:autofillHints="name"
                    android:hint="Nombre completo"
                    android:inputType="textPersonName|textCapWords" />

                <!-- Se oculta cuando el usuario ya entró con Google y solo completa sus datos -->
                <LinearLayout
                    android:id="@+id/layoutCuenta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:divider="@drawable/espacio"
                    android:orientation="vertical"
                    android:showDividers="middle">

                    <EditText
                        android:id="@+id/etCorreo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:autofillHints="emailAddress"
                        android:hint="Correo electrónico"
                        android:inputType="textEmailAddress" />

                    <EditText
                        android:id="@+id/etContrasena"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:autofillHints="newPassword"
                        android:hint="Contraseña"
                        android:inputType="textPassword" />

                    <TextView
                        android:id="@+id/tvReglas"
                        style="@style/Texto.Secundario"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:lineSpacingExtra="2dp"
                        android:paddingStart="4dp" />

                    <EditText
                        android:id="@+id/etConfirmar"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:autofillHints="newPassword"
                        android:hint="Confirmar contraseña"
                        android:inputType="textPassword" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Tarjeta: datos de una óptica nueva -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/layoutNueva"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:divider="@drawable/espacio"
                android:orientation="vertical"
                android:padding="16dp"
                android:showDividers="middle">

                <TextView
                    style="@style/Texto.Seccion"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Datos de la óptica" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/ivLogo"
                        android:layout_width="76dp"
                        android:layout_height="76dp"
                        android:background="@color/icono_fondo"
                        android:contentDescription="Logotipo de la óptica"
                        android:padding="20dp"
                        android:scaleType="centerCrop"
                        android:src="@drawable/ic_camara"
                        app:shapeAppearanceOverlay="@style/Forma.Circulo"
                        app:tint="@color/texto_secundario" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/Texto.Fila"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Logotipo" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <Button
                                android:id="@+id/btnLogoCamara"
                                style="@style/Boton.Texto"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Tomar foto" />

                            <Button
                                android:id="@+id/btnLogoGaleria"
                                style="@style/Boton.Texto"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Galería" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

                <EditText
                    android:id="@+id/etOpticaNombre"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Nombre comercial"
                    android:importantForAutofill="no"
                    android:inputType="textCapWords" />

                <EditText
                    android:id="@+id/etTelefono"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:autofillHints="phone"
                    android:hint="Teléfono"
                    android:inputType="phone" />

                <Spinner
                    android:id="@+id/spEstado"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <EditText
                    android:id="@+id/etDireccion"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:autofillHints="postalAddress"
                    android:hint="Dirección"
                    android:inputType="textPostalAddress" />

                <EditText
                    android:id="@+id/etMeta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Meta de ventas semanal ($)"
                    android:importantForAutofill="no"
                    android:inputType="numberDecimal" />

                <TextView
                    style="@style/Texto.Secundario"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Al terminar se generará un código de invitación para que tu personal se una a esta óptica." />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Tarjeta: unirse a una óptica existente -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/layoutUnirme"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:divider="@drawable/espacio"
                android:orientation="vertical"
                android:padding="16dp"
                android:showDividers="middle">

                <TextView
                    style="@style/Texto.Seccion"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Código de invitación" />

                <EditText
                    android:id="@+id/etCodigo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:drawableStart="@drawable/ic_llave"
                    android:drawablePadding="12dp"
                    android:drawableTint="@color/texto_secundario"
                    android:hint="Ej. OPT-7K2Q9X"
                    android:importantForAutofill="no"
                    android:inputType="textCapCharacters" />

                <TextView
                    style="@style/Texto.Secundario"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tu puesto en la óptica" />

                <Spinner
                    android:id="@+id/spRol"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <Button
            android:id="@+id/btnContinuar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Continuar" />

        <ProgressBar
            android:id="@+id/progreso"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:visibility="gone" />
    </LinearLayout>
</ScrollView>
