<?xml version="1.0" encoding="utf-8"?>
<!--
    Vista de acción de la opción "Personal" del menú lateral (app:actionLayout).
    MainActivity.actualizarInsigniaPersonal() escribe el número real de personas de la óptica.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="wrap_content"
    android:layout_height="match_parent">

    <TextView
        android:id="@+id/tvInsigniaPersonal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical"
        android:background="@drawable/bg_insignia_conteo"
        android:fontFamily="@font/lexend_medium"
        android:paddingStart="6dp"
        android:paddingTop="2dp"
        android:paddingEnd="6dp"
        android:paddingBottom="2dp"
        android:textColor="@color/insignia_conteo_texto"
        android:textSize="11sp"
        android:visibility="gone"
        tools:text="4 personas"
        tools:visibility="visible" />
</FrameLayout>
