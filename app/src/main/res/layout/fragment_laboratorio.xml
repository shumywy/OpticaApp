<?xml version="1.0" encoding="utf-8"?>
<!-- Pantalla 8: Órdenes de laboratorio -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingTop="4dp">

        <!-- Filtro por estatus -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipToPadding="false"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:scrollbars="none">

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipsEstatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:selectionRequired="true"
                app:singleLine="true"
                app:singleSelection="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipTodas"
                    style="@style/Filtro"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="Todas" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipEnviado"
                    style="@style/Filtro"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Enviado" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipEnProceso"
                    style="@style/Filtro"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="En proceso" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipRecibido"
                    style="@style/Filtro"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Recibido" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipEntregado"
                    style="@style/Filtro"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Entregado" />
            </com.google.android.material.chip.ChipGroup>
        </HorizontalScrollView>

        <TextView
            style="@style/Texto.Etiqueta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginTop="4dp"
            android:text="Toca una orden para cambiar su estatus" />

        <TextView
            android:id="@+id/tvVacio"
            style="@style/Texto.Secundario"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="32dp"
            android:text="No hay órdenes"
            android:visibility="gone" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvOrdenes"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="88dp"
            tools:itemCount="3"
            tools:listitem="@layout/item_orden" />
    </LinearLayout>

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabAgregar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="16dp"
        android:contentDescription="Nueva orden"
        android:src="@drawable/ic_agregar" />
</FrameLayout>
