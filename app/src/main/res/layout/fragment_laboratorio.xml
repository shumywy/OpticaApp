<?xml version="1.0" encoding="utf-8"?>
<!-- Pantalla 8: Órdenes de laboratorio -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- ===== Encabezado sobre el degradado ===== -->
    <LinearLayout
        android:id="@+id/encabezado"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="4dp"
        android:paddingEnd="24dp"
        android:paddingBottom="28dp">

        <TextView
            style="@style/Texto.Eyebrow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Seguimiento" />

        <TextView
            style="@style/Texto.Hero"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Laboratorio" />
    </LinearLayout>

    <!-- ===== Hoja blanca con filtros y órdenes ===== -->
    <FrameLayout
        android:id="@+id/hoja"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@drawable/bg_hoja">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingTop="24dp">

            <TextView
                style="@style/Texto.Seccion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:text="Órdenes" />

            <!-- Filtro por estatus -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:clipToPadding="false"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:scrollbars="none">

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/chipsEstatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:selectionRequired="true"
                    app:singleLine="true"
                    app:singleSelection="true">

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipTodas"
                        style="@style/Filtro"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:text="Todas" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipEnviado"
                        style="@style/Filtro"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Enviado" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipEnProceso"
                        style="@style/Filtro"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="En proceso" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipRecibido"
                        style="@style/Filtro"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Recibido" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipEntregado"
                        style="@style/Filtro"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Entregado" />
                </com.google.android.material.chip.ChipGroup>
            </HorizontalScrollView>

            <TextView
                style="@style/Texto.Categoria"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:layout_marginTop="6dp"
                android:text="Toca una orden para cambiar su estatus" />

            <TextView
                android:id="@+id/tvVacio"
                style="@style/Texto.Secundario"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="32dp"
                android:text="No hay órdenes"
                android:visibility="gone" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvOrdenes"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="4dp"
                android:layout_weight="1"
                android:clipToPadding="false"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingBottom="96dp"
                tools:itemCount="3"
                tools:listitem="@layout/item_orden" />
        </LinearLayout>

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fabAgregar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_margin="20dp"
            android:contentDescription="Nueva orden"
            android:src="@drawable/ic_agregar" />
    </FrameLayout>
</LinearLayout>
