<?xml version="1.0" encoding="utf-8"?>
<!-- Formulario para agregar o editar un producto (parte de la pantalla 6) -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:divider="@drawable/espacio"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="4dp"
        android:paddingEnd="16dp"
        android:paddingBottom="24dp"
        android:showDividers="middle">

        <!-- Foto grande del producto -->
        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/ivFoto"
            android:layout_width="150dp"
            android:layout_height="150dp"
            android:layout_gravity="center_horizontal"
            android:background="@color/superficie"
            android:contentDescription="Foto del producto"
            android:scaleType="centerCrop"
            app:shapeAppearanceOverlay="@style/Forma.Redondeada" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnCamara"
                style="@style/Boton.Secundario"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:text="Tomar foto"
                app:icon="@drawable/ic_camara" />

            <Button
                android:id="@+id/btnGaleria"
                style="@style/Boton.Secundario"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Galería"
                app:icon="@drawable/ic_imagen" />
        </LinearLayout>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:divider="@drawable/espacio"
                android:orientation="vertical"
                android:padding="16dp"
                android:showDividers="middle">

                <TextView
                    style="@style/Texto.Seccion"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Datos del producto" />

                <EditText
                    android:id="@+id/etNombre"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Nombre o modelo"
                    android:importantForAutofill="no"
                    android:inputType="textCapSentences" />

                <Spinner
                    android:id="@+id/spCategoria"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <EditText
                    android:id="@+id/etDescripcion"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Descripción (color, medidas, material)"
                    android:importantForAutofill="no"
                    android:inputType="textCapSentences" />

                <EditText
                    android:id="@+id/etPrecio"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Precio ($)"
                    android:importantForAutofill="no"
                    android:inputType="numberDecimal" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <EditText
                        android:id="@+id/etStock"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"
                        android:layout_weight="1"
                        android:hint="Existencias"
                        android:importantForAutofill="no"
                        android:inputType="number" />

                    <EditText
                        android:id="@+id/etStockMinimo"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:hint="Stock mínimo"
                        android:importantForAutofill="no"
                        android:inputType="number" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <Button
            android:id="@+id/btnGuardar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Guardar producto" />

        <Button
            android:id="@+id/btnEliminar"
            style="@style/Boton.Texto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Eliminar producto"
            android:textColor="@color/rojo"
            android:visibility="gone" />

        <ProgressBar
            android:id="@+id/progreso"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:visibility="gone" />
    </LinearLayout>
</ScrollView>
